# benchmarks/vayu/json_parse.vyu
#
# Generates a JSON document in memory, then exercises the json parser.
# The parse is the workload; generation is a preamble.

import json

N: int = 20000

def build_json() -> str:
    s: str = "["
    i: int = 0
    while i < N:
        if i > 0:
            s = s + ","
        s = s + "{\"id\":" + str(i) + ",\"name\":\"user_" + str(i) + "\",\"score\":" + str(i * 7 % 1000) + "}"
        i = i + 1
    s = s + "]"
    return s

def main() -> None:
    doc: str = build_json()
    parsed: int = json.parse(doc)
    n: int = json.len(parsed)
    print(n)
    total: int = 0
    i: int = 0
    while i < n:
        item: int = json.index(parsed, i)
        total = total + json.as_int(json.get(item, "id"))
        i = i + 1
    print(total)

main()