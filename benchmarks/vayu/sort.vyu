# benchmarks/vayu/sort.vyu
#
# Quicksort on a fixed-size list of pseudo-random ints.  Deterministic
# seed so output is stable.

N: int = 500000

def quicksort(a: list<int>, lo: int, hi: int) -> None:
    if lo >= hi:
        return
    pivot: int = a[(lo + hi) // 2]
    i: int = lo
    j: int = hi
    while i <= j:
        while a[i] < pivot:
            i = i + 1
        while a[j] > pivot:
            j = j - 1
        if i <= j:
            tmp: int = a[i]
            a[i] = a[j]
            a[j] = tmp
            i = i + 1
            j = j - 1
    if lo < j:
        quicksort(a, lo, j)
    if i < hi:
        quicksort(a, i, hi)

def main() -> None:
    a: list<int> = []
    seed: int = 12345
    i: int = 0
    while i < N:
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.append(seed % 1000000)
        i = i + 1

    quicksort(a, 0, N - 1)

    checksum: int = 0
    i = 0
    while i < N:
        checksum = (checksum + a[i] * (i + 1)) % 1000000007
        i = i + 1
    print(checksum)

main()