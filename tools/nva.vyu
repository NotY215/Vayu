# nva.vyu — Vayu package manager, v1.
#
# Usage:
#   nva new <name>
#   nva init
#   nva add <name> [version]
#   nva remove <name>
#   nva list
#   nva build
#   nva run
#   nva clean
#
# lib/ is resolved as follows (first hit wins):
#   1. ./lib/         exists -> use it
#   2. ./lib.zip      exists -> extract to ./lib/, then use it
#   3. neither        -> prompt to download tools/Lib.zip from GitHub

const LIB_ZIP_URL: str = "https://github.com/NotY215/Vayu/raw/master/tools/Lib.zip"
const LIB_DIR: str = "lib"
const LIB_ZIP: str = "lib.zip"

class Dep:
    name: str
    version: str
    def __init__(self, name: str, version: str) -> None:
        self.name = name
        self.version = version

class Manifest:
    name: str
    version: str
    author: str
    description: str
    entry: str
    deps: list<Dep>
    root_dir: str
    def __init__(self) -> None:
        self.name = ""
        self.version = "0.1.0"
        self.author = ""
        self.description = ""
        self.entry = "src/main.vyu"
        self.deps = []
        self.root_dir = ""

def trim(s: str) -> str:
    return s.strip()

def is_blank_or_comment(line: str) -> bool:
    t = trim(line)
    if len(t) == 0:
        return true
    if t.starts_with("#"):
        return true
    return false

def join_lines(lines: list<str>) -> str:
    out = ""
    i = 0
    while i < len(lines):
        if i > 0:
            out = out + "\n"
        out = out + lines[i]
        i = i + 1
    return out

def str_in_list(s: str, lst: list<str>) -> bool:
    i = 0
    while i < len(lst):
        if lst[i] == s:
            return true
        i = i + 1
    return false

def parse_manifest(path: str) -> Manifest:
    src = read_file(path)
    lines = src.split("\n")
    m = Manifest()
    section = ""
    i = 0
    while i < len(lines):
        raw = lines[i]
        line = trim(raw)
        i = i + 1
        if is_blank_or_comment(line):
            continue
        if line.starts_with("[") and line.ends_with("]"):
            section = line.substr(1, len(line) - 1)
            continue
        eq = line.find("=")
        if eq < 0:
            continue
        key = trim(line.substr(0, eq))
        val = trim(line.substr(eq + 1, len(line)))
        if val.starts_with("\"") and val.ends_with("\"") and len(val) >= 2:
            val = val.substr(1, len(val) - 1)
        if section == "package":
            if key == "name":
                m.name = val
            if key == "version":
                m.version = val
            if key == "author":
                m.author = val
            if key == "description":
                m.description = val
            if key == "entry":
                m.entry = val
        if section == "dependencies":
            m.deps.append(Dep(key, val))
    return m

def join_path(a: str, b: str) -> str:
    if len(a) == 0:
        return b
    if a.ends_with("/") or a.ends_with("\\"):
        return a + b
    return a + "/" + b

def dir_exists(p: str) -> bool:
    rc = run_command("dir \"" + p + "\" /ad /b >nul 2>nul")
    if rc == 0:
        return true
    return false

def mkdir(p: str) -> None:
    run_command("mkdir \"" + p + "\" 2>nul")

def find_up(rel_path: str) -> str:
    if file_exists(rel_path):
        return rel_path
    p1 = "..\\" + rel_path
    if file_exists(p1):
        return p1
    p2 = "..\\..\\" + rel_path
    if file_exists(p2):
        return p2
    p3 = "..\\..\\..\\" + rel_path
    if file_exists(p3):
        return p3
    p4 = "..\\..\\..\\..\\" + rel_path
    if file_exists(p4):
        return p4
    p5 = "..\\..\\..\\..\\..\\" + rel_path
    if file_exists(p5):
        return p5
    p6 = "..\\..\\..\\..\\..\\..\\" + rel_path
    if file_exists(p6):
        return p6
    return ""

def find_vayuc() -> str:
    p = find_up("build\\x64-debug\\bin\\vayuc.exe")
    if p == "":
        return "vayuc.exe"
    return p

def find_qbe() -> str:
    return find_up("tools\\qbe.exe")

def find_dep_dir(name: str, root: str) -> str:
    p1 = join_path(join_path(root, "nova_modules"), name)
    if dir_exists(p1):
        return p1
    p2 = join_path(join_path(root, ".."), name)
    if dir_exists(p2):
        return p2
    return ""

def resolve_modules(m: Manifest) -> str:
    parts: list<str> = []
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        ddir = find_dep_dir(d.name, m.root_dir)
        if ddir == "":
            print("nva: missing dependency '" + d.name + "'")
            exit(1)
        parts.append(ddir)
        sub_toml = join_path(ddir, "nova.toml")
        if file_exists(sub_toml):
            sub = parse_manifest(sub_toml)
            sub.root_dir = ddir
            j = 0
            while j < len(sub.deps):
                sd = sub.deps[j]
                sdir = find_dep_dir(sd.name, ddir)
                if sdir != "":
                    parts.append(sdir)
                j = j + 1
        i = i + 1
    out = ""
    k = 0
    while k < len(parts):
        if k > 0:
            out = out + ";"
        out = out + parts[k]
        k = k + 1
    return out

# ---------------------------------------------------------------------------
# lib folder / lib.zip management
# ---------------------------------------------------------------------------

def extract_lib_zip() -> None:
    print("nva: extracting " + LIB_ZIP + " ...")
    # Expand-Archive requires PowerShell 5+; DestinationPath '.' puts
    # the top-level folder (lib/) back in the current directory.
    cmd = "powershell -NoProfile -Command \"Expand-Archive -Path '" + LIB_ZIP + "' -DestinationPath '.' -Force\""
    rc = run_command(cmd)
    if rc != 0:
        print("nva: failed to extract " + LIB_ZIP)
        exit(1)

def download_lib_zip() -> bool:
    print("nva: downloading " + LIB_ZIP + " ...")
    # Prefer curl.exe (ships with Windows 10+).
    rc = run_command("curl -L -s -o " + LIB_ZIP + " \"" + LIB_ZIP_URL + "\"")
    if rc != 0:
        # Fallback: PowerShell Invoke-WebRequest.
        cmd = "powershell -NoProfile -Command \"Invoke-WebRequest -UseBasicParsing -Uri '" + LIB_ZIP_URL + "' -OutFile '" + LIB_ZIP + "'\""
        rc = run_command(cmd)
    return rc == 0

def ensure_lib() -> None:
    # Fast path — lib/ already present, nothing to do.
    if dir_exists(LIB_DIR):
        return
    # lib.zip present — extract and go.
    if file_exists(LIB_ZIP):
        extract_lib_zip()
        return
    # Neither present — ask.
    print("nva: lib/ is missing and lib.zip was not found.")
    print("nva: download lib.zip from GitHub? (Y/N)")
    ans = read_line().strip()
    if ans == "Y" or ans == "y":
        if not download_lib_zip():
            print("nva: download failed.")
            exit(1)
        extract_lib_zip()
    else:
        print("nva: cancelled — lib/ is required to build.")
        exit(1)

# ---------------------------------------------------------------------------
# toml editing
# ---------------------------------------------------------------------------

def toml_add_dep(path: str, name: str, version: str) -> None:
    src = read_file(path)
    lines = src.split("\n")
    dep_start = -1
    dep_end = -1
    i = 0
    while i < len(lines):
        t = trim(lines[i])
        if t == "[dependencies]":
            dep_start = i
            j = i + 1
            while j < len(lines):
                u = trim(lines[j])
                if u.starts_with("[") and u.ends_with("]"):
                    break
                if len(u) > 0:
                    dep_end = j
                j = j + 1
            break
        i = i + 1

    new_line = name + " = \"" + version + "\""
    new_lines: list<str> = []
    if dep_start < 0:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            k = k + 1
        new_lines.append("")
        new_lines.append("[dependencies]")
        new_lines.append(new_line)
    elif dep_end < 0:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_start:
                new_lines.append(new_line)
            k = k + 1
    else:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_end:
                new_lines.append(new_line)
            k = k + 1
    write_file(path, join_lines(new_lines))

def toml_remove_dep(path: str, name: str) -> None:
    src = read_file(path)
    lines = src.split("\n")
    in_deps = false
    out_lines: list<str> = []
    i = 0
    while i < len(lines):
        line = lines[i]
        t = trim(line)
        if t == "[dependencies]":
            in_deps = true
            out_lines.append(line)
            i = i + 1
            continue
        if in_deps and t.starts_with("[") and t.ends_with("]"):
            in_deps = false
        if in_deps and len(t) > 0:
            eq = t.find("=")
            if eq >= 0:
                key = trim(t.substr(0, eq))
                if key == name:
                    i = i + 1
                    continue
        out_lines.append(line)
        i = i + 1
    write_file(path, join_lines(out_lines))

# ---------------------------------------------------------------------------
# lock file
# ---------------------------------------------------------------------------

def collect_lock_entries(m: Manifest, out: list<str>, visited: list<str>) -> None:
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        if not str_in_list(d.name, visited):
            visited.append(d.name)
            ddir = find_dep_dir(d.name, m.root_dir)
            out.append(d.name + " " + d.version + " " + ddir)
            sub_toml = join_path(ddir, "nova.toml")
            if file_exists(sub_toml):
                sub = parse_manifest(sub_toml)
                sub.root_dir = ddir
                collect_lock_entries(sub, out, visited)
        i = i + 1

def write_lock(m: Manifest) -> None:
    lines: list<str> = []
    lines.append("# nva lock file, format v1")
    lines.append("# do not edit by hand; regenerate with 'nva build'")
    lines.append("# fields: name version path")
    visited: list<str> = []
    collect_lock_entries(m, lines, visited)
    write_file("nova.lock", join_lines(lines) + "\n")

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_new(name: str) -> None:
    root = name
    mkdir(root)
    mkdir(join_path(root, "src"))
    toml = "[package]\n"
    toml = toml + "name = \"" + name + "\"\n"
    toml = toml + "version = \"0.1.0\"\n"
    toml = toml + "author = \"\"\n"
    toml = toml + "description = \"\"\n"
    toml = toml + "entry = \"src/main.vyu\"\n"
    toml = toml + "\n"
    toml = toml + "[dependencies]\n"
    write_file(join_path(root, "nova.toml"), toml)
    main_src = "print(\"Hello from " + name + "!\")\n"
    write_file(join_path(root, "src/main.vyu"), main_src)
    print("nva: created project '" + name + "'")
    print("     cd " + name)
    print("     nva run")

def cmd_init() -> None:
    toml = "[package]\n"
    toml = toml + "name = \"app\"\n"
    toml = toml + "version = \"0.1.0\"\n"
    toml = toml + "author = \"\"\n"
    toml = toml + "description = \"\"\n"
    toml = toml + "entry = \"src/main.vyu\"\n"
    toml = toml + "\n"
    toml = toml + "[dependencies]\n"
    write_file("nova.toml", toml)
    mkdir("src")
    if not file_exists("src/main.vyu"):
        write_file("src/main.vyu", "print(\"Hello, Vayu!\")\n")
    print("nva: initialized nova.toml")

def cmd_add(name: str, version: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    i = 0
    while i < len(m.deps):
        if m.deps[i].name == name:
            print("nva: '" + name + "' is already a dependency")
            exit(1)
        i = i + 1
    toml_add_dep("nova.toml", name, version)
    print("nva: added " + name + " = \"" + version + "\"")

def cmd_remove(name: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    found = false
    i = 0
    while i < len(m.deps):
        if m.deps[i].name == name:
            found = true
        i = i + 1
    toml_remove_dep("nova.toml", name)
    if found:
        print("nva: removed " + name)
    else:
        print("nva: '" + name + "' was not a dependency")

def print_dep_tree(m: Manifest, indent: int, visited: list<str>) -> None:
    pad = ""
    k = 0
    while k < indent:
        pad = pad + "  "
        k = k + 1
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        if str_in_list(d.name, visited):
            print(pad + d.name + " " + d.version + " (already shown)")
            i = i + 1
            continue
        visited.append(d.name)
        ddir = find_dep_dir(d.name, m.root_dir)
        if ddir == "":
            print(pad + d.name + " " + d.version + " (MISSING)")
        else:
            print(pad + d.name + " " + d.version + " -> " + ddir)
            sub_toml = join_path(ddir, "nova.toml")
            if file_exists(sub_toml):
                sub = parse_manifest(sub_toml)
                sub.root_dir = ddir
                print_dep_tree(sub, indent + 1, visited)
        i = i + 1

def cmd_list() -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    m.root_dir = ""
    if m.name == "":
        print("nva: nova.toml has no package.name")
        exit(1)
    print(m.name + " " + m.version)
    if len(m.deps) == 0:
        print("  (no dependencies)")
        return
    visited: list<str> = []
    print_dep_tree(m, 1, visited)

def cmd_build() -> str:
    ensure_lib()
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    m.root_dir = ""
    if m.name == "":
        print("nva: nova.toml has no package.name")
        exit(1)
    mod_path = resolve_modules(m)
    mkdir("build")

    entry_win = m.entry.replace("/", "\\")
    exe_win = "build\\" + m.name + ".exe"

    compiler = find_vayuc()
    if compiler == "vayuc.exe":
        print("nva: warning: vayuc.exe not found in build/x64-debug/bin")
        print("nva: falling back to PATH lookup")

    qbe = find_qbe()
    if qbe == "":
        print("nva: warning: tools/qbe.exe not found by walking up")

    prefix = ""
    if len(mod_path) > 0:
        mod_path_win = mod_path.replace("/", "\\")
        prefix = prefix + "set \"VAYU_MODULE_PATH=" + mod_path_win + "\" && "
    if len(qbe) > 0:
        prefix = prefix + "set \"VAYU_QBE=" + qbe + "\" && "
    run_part = "call \"" + compiler + "\" \"" + entry_win + "\" --native-out \"" + exe_win + "\""
    cmd = prefix + run_part

    print("nva: building " + m.name + " ...")
    rc = run_command(cmd)
    if rc != 0:
        print("nva: build failed (exit " + str(rc) + ")")
        exit(1)
    write_lock(m)
    print("nva: built " + exe_win)
    return exe_win

def cmd_run() -> None:
    exe = cmd_build()
    print("nva: running " + exe)
    run_command("\"" + exe + "\"")

def cmd_clean() -> None:
    if dir_exists("build"):
        run_command("rmdir /s /q build 2>nul")
    if file_exists("nova.lock"):
        print("nva: kept nova.lock (regenerated on next build)")
    print("nva: cleaned")

def main() -> None:
    a = args()
    if len(a) < 1:
        print("usage: nva <command> [args]")
        print("       nva new <name>")
        print("       nva init")
        print("       nva add <name> [version]")
        print("       nva remove <name>")
        print("       nva list")
        print("       nva build")
        print("       nva run")
        print("       nva clean")
        exit(1)
    cmd = a[0]
    if cmd == "new":
        if len(a) < 2:
            print("nva: 'new' requires a project name")
            exit(1)
        cmd_new(a[1])
        return
    if cmd == "init":
        cmd_init()
        return
    if cmd == "add":
        if len(a) < 2:
            print("nva: 'add' requires a package name")
            exit(1)
        ver = "0.1.0"
        if len(a) >= 3:
            ver = a[2]
        cmd_add(a[1], ver)
        return
    if cmd == "remove":
        if len(a) < 2:
            print("nva: 'remove' requires a package name")
            exit(1)
        cmd_remove(a[1])
        return
    if cmd == "list":
        cmd_list()
        return
    if cmd == "build":
        cmd_build()
        return
    if cmd == "run":
        cmd_run()
        return
    if cmd == "clean":
        cmd_clean()
        return
    print("nva: unknown command '" + cmd + "'")
    exit(1)

main()