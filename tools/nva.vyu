# nva.vyu — Vayu package manager, v1.
#
# Usage:
#   nva new <name>
#   nva init
#   nva add <name> [version]
#   nva remove <name>
#   nva list
#   nva build
#   nva run
#   nva clean
#
# lib/ is resolved as follows (first hit wins):
#   1. ./lib/         exists -> use it
#   2. ./lib.zip      exists -> extract to ./lib/, then use it
#   3. neither        -> prompt to download tools/Lib.zip from GitHub

const LIB_ZIP_URL: str = "https://github.com/NotY215/Vayu/raw/master/tools/Lib.zip"
const LIB_DIR: str = "lib"
const LIB_ZIP: str = "lib.zip"

# ---------------------------------------------------------------------------
# Phase 23.0 - semantic versioning (parse, compare, match).
# ---------------------------------------------------------------------------

def _semver_parse(s: str) -> list<int>:
    # "1.2.3" or "1.2" -> [1, 2, 3].  Pre-release tags (-alpha, +meta)
    # are trimmed.  Returns [] on any parse failure.
    parts: list<int> = []
    cur: str = ""
    i: int = 0
    while i < len(s):
        c: str = s[i]
        if c == ".":
            if len(cur) == 0:
                return []
            parts.append(int(cur))
            cur = ""
        elif c == "-":
            break
        elif c == "+":
            break
        elif c >= "0" and c <= "9":
            cur = cur + c
        else:
            return []
        i = i + 1
    if len(cur) > 0:
        parts.append(int(cur))
    while len(parts) < 3:
        parts.append(0)
    if len(parts) > 3:
        return []
    return parts

def _semver_cmp(a: list<int>, b: list<int>) -> int:
    i: int = 0
    while i < 3:
        if a[i] < b[i]:
            return 0 - 1
        if a[i] > b[i]:
            return 1
        i = i + 1
    return 0

def _constraint_matches(version: str, op: str, target: str) -> bool:
    v: list<int> = _semver_parse(version)
    t: list<int> = _semver_parse(target)
    if len(v) == 0 or len(t) == 0:
        return false
    c: int = _semver_cmp(v, t)
    if op == "=":
        return c == 0
    if op == ">=":
        return c >= 0
    if op == ">":
        return c > 0
    if op == "<=":
        return c <= 0
    if op == "<":
        return c < 0
    return false

def _caret_matches(version: str, base: str) -> bool:
    # ^1.2.3 -> >= 1.2.3, < 2.0.0
    v: list<int> = _semver_parse(version)
    b: list<int> = _semver_parse(base)
    if len(v) == 0 or len(b) == 0:
        return false
    if _semver_cmp(v, b) < 0:
        return false
    if b[0] > 0:
        return v[0] == b[0]
    if b[1] > 0:
        return v[0] == 0 and v[1] == b[1]
    return v[0] == 0 and v[1] == 0 and v[2] == b[2]

def _tilde_matches(version: str, base: str) -> bool:
    # ~1.2.3 -> >= 1.2.3, < 1.3.0
    v: list<int> = _semver_parse(version)
    b: list<int> = _semver_parse(base)
    if len(v) == 0 or len(b) == 0:
        return false
    if _semver_cmp(v, b) < 0:
        return false
    return v[0] == b[0] and v[1] == b[1]

def version_matches(range: str, version: str) -> bool:
    r: str = range.strip()
    if len(r) == 0 or r == "*":
        return true
    if r[0] == "^":
        return _caret_matches(version, r.substr(1, len(r)))
    if r[0] == "~":
        return _tilde_matches(version, r.substr(1, len(r)))
    if r.starts_with(">="):
        return _constraint_matches(version, ">=", r.substr(2, len(r)))
    if r.starts_with("<="):
        return _constraint_matches(version, "<=", r.substr(2, len(r)))
    if r.starts_with(">"):
        return _constraint_matches(version, ">", r.substr(1, len(r)))
    if r.starts_with("<"):
        return _constraint_matches(version, "<", r.substr(1, len(r)))
    if r.starts_with("="):
        return _constraint_matches(version, "=", r.substr(1, len(r)))
    return _constraint_matches(version, "=", r)

def best_match(range: str, candidates: list<str>) -> str:
    # Highest candidate that satisfies the range.  "" if none.
    best: str = ""
    best_parts: list<int> = []
    i: int = 0
    while i < len(candidates):
        c: str = candidates[i]
        if version_matches(range, c):
            cp: list<int> = _semver_parse(c)
            if len(cp) > 0:
                if len(best) == 0 or _semver_cmp(cp, best_parts) > 0:
                    best = c
                    best_parts = cp
        i = i + 1
    return best

# ---------------------------------------------------------------------------
# Phase 23.3 + 23.4 - git dependencies + transitive solver.
#
# nova.toml dependency forms:
#   name = "1.0.0"                                          -- registry
#   name = { git = "URL" }                                  -- default branch
#   name = { git = "URL", tag = "v1.0.0" }                  -- tag
#   name = { git = "URL", branch = "main" }                 -- branch
#   name = { git = "URL", rev = "abc123" }                  -- commit
#
# Git deps are cloned into <project>/nova_modules/<name>.  When a
# transitive dep comes from a git source, the same rule applies to its
# own nova_modules/.
# ---------------------------------------------------------------------------

class DepNode:
    name: str
    version: str
    git: str
    git_ref_kind: str
    git_ref_value: str
    depth: int
    dir: str

    def __init__(self) -> None:
        self.name = ""
        self.version = ""
        self.git = ""
        self.git_ref_kind = ""
        self.git_ref_value = ""
        self.depth = 0
        self.dir = ""

def _git_available() -> bool:
    rc: int = run_command("git --version >nul 2>nul")
    if rc != 0:
        rc = run_command("git --version >/dev/null 2>&1")
    return rc == 0

def _git_clone(url: str, ref_kind: str, ref_val: str, dst: str) -> int:
    if not _git_available():
        print("nva: git not found on PATH")
        return 1
    _rmtree(dst)
    _mkdirs(fs.dirname(dst))
    rc: int = 0
    quiet: str = " -q"
    na: str = " -c advice.detachedHead=false"
    if ref_kind == "tag":
        # Tags: full clone then checkout.  --depth 1 --branch <tag> is
        # unreliable for tags on local repos.
        rc = run_command("git clone" + quiet + " \"" + url + "\" \"" + dst + "\"")
        if rc == 0:
            rc = run_command("git -C \"" + dst + "\"" + na + " checkout \"" + ref_val + "\"")
    elif ref_kind == "branch":
        rc = run_command("git clone" + quiet + " --depth 1 --branch \"" + ref_val + "\" \"" + url + "\" \"" + dst + "\"")
    elif ref_kind == "rev":
        rc = run_command("git clone" + quiet + " \"" + url + "\" \"" + dst + "\"")
        if rc == 0:
            rc = run_command("git -C \"" + dst + "\"" + na + " checkout \"" + ref_val + "\"")
    else:
        rc = run_command("git clone" + quiet + " --depth 1 \"" + url + "\" \"" + dst + "\"")
    return rc

def _dep_dir_for(d: Dep, base_dir: str) -> str:
    # Already-installed dep in nova_modules?
    p1: str = base_dir + "/nova_modules/" + d.name
    if fs.exists(p1):
        return p1
    # Sibling directory (development layout)?
    p2: str = fs.dirname(fs.abs(base_dir)) + "/" + d.name
    if fs.exists(p2):
        return p2
    return ""

def collect_graph(m: Manifest, base_dir: str, visited: list<str>, depth: int, out: list<DepNode>) -> None:
    i: int = 0
    while i < len(m.deps):
        d: Dep = m.deps[i]
        i = i + 1
        if str_in_list(d.name, visited):
            continue
        visited.append(d.name)

        dep_dir: str = _dep_dir_for(d, base_dir)
        if len(dep_dir) == 0 and len(d.git) > 0:
            dep_dir = base_dir + "/nova_modules/" + d.name
            if not fs.exists(dep_dir):
                rc: int = _git_clone(d.git, d.git_ref_kind, d.git_ref_value, dep_dir)
                if rc != 0:
                    print("nva: git clone failed for '" + d.name + "' (" + d.git + ")")
                    return

        # Recurse into sub-manifest first (post-order visit).
        sub_toml: str = dep_dir + "/nova.toml"
        if len(dep_dir) > 0 and file_exists(sub_toml):
            sub: Manifest = parse_manifest(sub_toml)
            collect_graph(sub, dep_dir, visited, depth + 1, out)

        n: DepNode = DepNode()
        n.name = d.name
        n.version = d.version
        n.git = d.git
        n.git_ref_kind = d.git_ref_kind
        n.git_ref_value = d.git_ref_value
        n.depth = depth
        n.dir = dep_dir
        out.append(n)

def detect_conflicts(nodes: list<DepNode>) -> list<str>:
    conflicts: list<str> = []
    i: int = 0
    while i < len(nodes):
        ni: DepNode = nodes[i]
        i = i + 1
        j: int = i
        while j < len(nodes):
            nj: DepNode = nodes[j]
            j = j + 1
            if ni.name == nj.name and ni.version != nj.version:
                msg: str = ni.name + ": " + ni.version + " vs " + nj.version
                if not str_in_list(msg, conflicts):
                    conflicts.append(msg)
    return conflicts

def _depnode_ref_str(n: DepNode) -> str:
    if len(n.git) == 0:
        return "registry " + n.version
    if n.git_ref_kind == "tag":
        return "git tag " + n.git_ref_value
    if n.git_ref_kind == "branch":
        return "git branch " + n.git_ref_value
    if n.git_ref_kind == "rev":
        return "git rev " + n.git_ref_value
    return "git default"

def print_tree_node(n: DepNode) -> None:
    pad: str = ""
    k: int = 0
    while k < n.depth:
        pad = pad + "  "
        k = k + 1
    line: str = pad + n.name
    if len(n.version) > 0:
        line = line + " " + n.version
    line = line + "  (" + _depnode_ref_str(n) + ")"
    if len(n.dir) > 0:
        line = line + "  -> " + n.dir
    print(line)

def resolve_modules_full(m: Manifest, root_dir: str) -> str:
    visited: list<str> = []
    nodes: list<DepNode> = []
    collect_graph(m, root_dir, visited, 0, nodes)
    # VAYU_MODULE_PATH: direct deps first, then transitive in post-order.
    parts: list<str> = []
    i: int = len(nodes) - 1
    while i >= 0:
        n: DepNode = nodes[i]
        if len(n.dir) > 0:
            parts.append(n.dir)
        i = i - 1
    out: str = ""
    k: int = 0
    while k < len(parts):
        if k > 0:
            out = out + ";"
        out = out + parts[k]
        k = k + 1
    return out

# ---------------------------------------------------------------------------
# toml_add_git_dep: insert an inline-table git dependency line.
# ---------------------------------------------------------------------------

def toml_add_git_dep(path: str, name: str, url: str, ref_kind: str, ref_val: str) -> None:
    src: str = read_file(path)
    lines: list<str> = src.split("\n")
    dep_start: int = -1
    dep_end: int = -1
    i: int = 0
    while i < len(lines):
        t: str = trim(lines[i])
        if t == "[dependencies]":
            dep_start = i
            j: int = i + 1
            while j < len(lines):
                u: str = trim(lines[j])
                if u.starts_with("[") and u.ends_with("]"):
                    break
                if len(u) > 0:
                    dep_end = j
                j = j + 1
            break
        i = i + 1

    new_line: str = name + " = { git = \"" + url + "\""
    if ref_kind == "tag":
        new_line = new_line + ", tag = \"" + ref_val + "\""
    elif ref_kind == "branch":
        new_line = new_line + ", branch = \"" + ref_val + "\""
    elif ref_kind == "rev":
        new_line = new_line + ", rev = \"" + ref_val + "\""
    new_line = new_line + " }"

    new_lines: list<str> = []
    if dep_start < 0:
        k: int = 0
        while k < len(lines):
            new_lines.append(lines[k])
            k = k + 1
        new_lines.append("")
        new_lines.append("[dependencies]")
        new_lines.append(new_line)
    elif dep_end < 0:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_start:
                new_lines.append(new_line)
            k = k + 1
    else:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_end:
                new_lines.append(new_line)
            k = k + 1
    write_file(path, join_lines(new_lines))

# ---------------------------------------------------------------------------
# Phase 23.1 + 23.2 - local + remote registry.
#
# Layout under a registry root:
#   <root>/index.txt                          -- "<name> <version>" per line
#   <root>/packages/<name>/<version>/         -- unpacked package tree
#
# Discovery order for the registry root:
#   1. NVA_REGISTRY env var
#   2. .nva/config in cwd
#   3. ~/.nva/config
# Remote base URL uses the same three-tier lookup with NVA_REGISTRY_REMOTE.
# Remote layout over HTTP:
#   GET <base>/index.txt
#   GET <base>/packages/<name>/<version>.tar
#   POST <base>/publish   (body: package tar)
# ---------------------------------------------------------------------------

class NvaConfig:
    registry: str
    registry_remote: str

    def __init__(self) -> None:
        self.registry = ""
        self.registry_remote = ""

def _mkdirs(path: str) -> None:
    # Recursive mkdir.  Vayu stdlib only has single-level fs.mkdir.
    if len(path) == 0:
        return
    norm: str = path.replace("\\", "/")
    parts: list<str> = norm.split("/")
    cur: str = ""
    i: int = 0
    while i < len(parts):
        p: str = parts[i]
        if len(p) > 0:
            if len(cur) == 0:
                cur = p
            else:
                cur = cur + "/" + p
            if not fs.exists(cur):
                fs.mkdir(cur)
        elif i == 0:
            cur = "/"
        i = i + 1

def _rmtree(path: str) -> None:
    if not fs.exists(path):
        return
    if os.platform() == "windows":
        # attrib clears the read-only bit that git sets on .git internals.
        run_command("attrib -r -h -s \"" + path + "\" /s /d >nul 2>nul")
        run_command("cmd /c rmdir /s /q \"" + path + "\" >nul 2>nul")
    else:
        run_command("chmod -R u+w \"" + path + "\" >/dev/null 2>&1")
        run_command("rm -rf \"" + path + "\" >/dev/null 2>&1")

def _home_dir() -> str:
    h: str = os.getenv("USERPROFILE")
    if len(h) > 0:
        return h
    return os.getenv("HOME")

def _config_parse_into(path: str, c: NvaConfig) -> None:
    src: str = read_file(path)
    lines: list<str> = src.split("\n")
    i: int = 0
    while i < len(lines):
        line: str = trim(lines[i])
        i = i + 1
        if is_blank_or_comment(line):
            continue
        eq: int = line.find("=")
        if eq < 0:
            continue
        key: str = trim(line.substr(0, eq))
        val: str = trim(line.substr(eq + 1, len(line)))
        if key == "registry" and len(val) > 0:
            c.registry = val
        if key == "registry_remote" and len(val) > 0:
            c.registry_remote = val

def _config_read() -> NvaConfig:
    c: NvaConfig = NvaConfig()
    r: str = os.getenv("NVA_REGISTRY")
    if len(r) > 0:
        c.registry = r
    r2: str = os.getenv("NVA_REGISTRY_REMOTE")
    if len(r2) > 0:
        c.registry_remote = r2
    if file_exists(".nva/config"):
        _config_parse_into(".nva/config", c)
    else:
        h: str = _home_dir()
        if len(h) > 0:
            hc: str = h + "/.nva/config"
            if file_exists(hc):
                _config_parse_into(hc, c)
    return c

def _config_write(c: NvaConfig) -> None:
    _mkdirs(".nva")
    body: str = ""
    if len(c.registry) > 0:
        body = body + "registry=" + c.registry + "\n"
    if len(c.registry_remote) > 0:
        body = body + "registry_remote=" + c.registry_remote + "\n"
    write_file(".nva/config", body)

def _index_path(root: str) -> str:
    return root + "/index.txt"

def _index_read(root: str) -> list<str>:
    p: str = _index_path(root)
    if not file_exists(p):
        return []
    src: str = read_file(p)
    lines: list<str> = src.split("\n")
    out: list<str> = []
    i: int = 0
    while i < len(lines):
        t: str = trim(lines[i])
        i = i + 1
        if is_blank_or_comment(t):
            continue
        out.append(t)
    return out

def _index_write(root: str, lines: list<str>) -> None:
    _mkdirs(root)
    body: str = "# nva-registry-index v1\n"
    i: int = 0
    while i < len(lines):
        body = body + lines[i] + "\n"
        i = i + 1
    write_file(_index_path(root), body)

def _index_add(root: str, name: str, version: str) -> None:
    lines: list<str> = _index_read(root)
    entry: str = name + " " + version
    i: int = 0
    while i < len(lines):
        if lines[i] == entry:
            return
        i = i + 1
    lines.append(entry)
    _index_write(root, lines)

class SemverTest:
    passes: int
    fails: int

    def __init__(self) -> None:
        self.passes = 0
        self.fails = 0

    def check(self, name: str, got: bool, want: bool) -> None:
        if got == want:
            print("  PASS  " + name)
            self.passes = self.passes + 1
        else:
            print("  FAIL  " + name)
            self.fails = self.fails + 1

def _pkg_versions(root: str, name: str) -> list<str>:
    lines: list<str> = _index_read(root)
    out: list<str> = []
    i: int = 0
    while i < len(lines):
        ln: str = lines[i]
        i = i + 1
        sp: int = ln.find(" ")
        if sp <= 0:
            continue
        n: str = ln.substr(0, sp)
        v: str = trim(ln.substr(sp + 1, len(ln)))
        if n == name:
            out.append(v)
    return out

def _pkg_dir(root: str, name: str, version: str) -> str:
    return root + "/packages/" + name + "/" + version

def _make_tar(src_dir: str, out_tar: str) -> int:
    parent: str = fs.dirname(fs.abs(src_dir))
    leaf: str = fs.basename(fs.abs(src_dir))
    opts: str = "--exclude=.git --exclude=build --exclude=nova_modules --exclude=out --exclude=.vscode --exclude=_nva_test"
    cmd: str = "tar -cf \"" + out_tar + "\" " + opts + " -C \"" + parent + "\" \"" + leaf + "\""
    return run_command(cmd)

def _extract_tar_flat(tar_path: str, dst_dir: str) -> int:
    _mkdirs(dst_dir)
    cmd: str = "tar -xf \"" + tar_path + "\" -C \"" + dst_dir + "\" --strip-components=1"
    return run_command(cmd)

def _copy_tree(src: str, dst: str) -> int:
    _mkdirs(dst)
    tmp: str = dst + ".nva_copy.tar"
    rc: int = _make_tar(src, tmp)
    if rc != 0:
        return rc
    rc = _extract_tar_flat(tmp, dst)
    fs.remove(tmp)
    return rc

def _http_get(url: str, out_path: str) -> int:
    _mkdirs(fs.dirname(out_path))
    cmd: str = "curl -L -s -o \"" + out_path + "\" \"" + url + "\""
    return run_command(cmd)

def _http_post_file(url: str, file_path: str, out_path: str) -> int:
    cmd: str = "curl -L -s -X POST --data-binary @\"" + file_path + "\" -o \"" + out_path + "\" \"" + url + "\""
    return run_command(cmd)

def _flag_value(a: list<str>, flag: str) -> str:
    i: int = 0
    while i < len(a):
        if a[i] == flag and i + 1 < len(a):
            return a[i + 1]
        i = i + 1
    return ""

def cmd_registry(path: str) -> None:
    c: NvaConfig = _config_read()
    if len(path) == 0:
        if len(c.registry) == 0:
            print("nva: registry not set")
        else:
            print(c.registry)
        return
    c.registry = fs.abs(path)
    _config_write(c)
    print("nva: registry = " + c.registry)

def cmd_registry_remote(url: str) -> None:
    c: NvaConfig = _config_read()
    if len(url) == 0:
        if len(c.registry_remote) == 0:
            print("nva: remote registry not set")
        else:
            print(c.registry_remote)
        return
    c.registry_remote = url
    _config_write(c)
    print("nva: registry_remote = " + url)

def cmd_publish_local(registry: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m: Manifest = parse_manifest("nova.toml")
    if len(m.name) == 0 or len(m.version) == 0:
        print("nva: nova.toml missing name or version")
        exit(1)

    root: str = registry
    if len(root) == 0:
        cfg: NvaConfig = _config_read()
        root = cfg.registry
    if len(root) == 0:
        print("nva: no registry configured; pass --registry <path>")
        exit(1)
    # Deliberately do NOT call fs.abs here.  mingw-w64's _fullpath is not
    # idempotent for already-absolute paths when cwd differs, and fopen
    # handles both relative and absolute paths natively.

    pkg: str = _pkg_dir(root, m.name, m.version)
    _rmtree(pkg)
    _mkdirs(pkg)

    _mkdirs(root)
    tmp_tar: str = root + "/.tmp_publish_" + m.name + ".tar"
    rc: int = _make_tar(fs.cwd(), tmp_tar)
    if rc != 0:
        print("nva: tar creation failed (rc=" + str(rc) + ")")
        exit(1)
    rc = _extract_tar_flat(tmp_tar, pkg)
    fs.remove(tmp_tar)
    if rc != 0:
        print("nva: tar extraction failed (rc=" + str(rc) + ")")
        exit(1)

    _index_add(root, m.name, m.version)
    print("nva: published " + m.name + " " + m.version + " to " + pkg)

def cmd_search(query: str, registry: str) -> None:
    root: str = registry
    if len(root) == 0:
        cfg: NvaConfig = _config_read()
        root = cfg.registry
    if len(root) == 0:
        print("nva: no registry configured")
        exit(1)
    # No fs.abs: see comment in cmd_publish_local.
    lines: list<str> = _index_read(root)
    count: int = 0
    i: int = 0
    while i < len(lines):
        ln: str = lines[i]
        i = i + 1
        if len(query) > 0 and not ln.contains(query):
            continue
        print("  " + ln)
        count = count + 1
    print("nva: " + str(count) + " package version(s)")

def cmd_install(name: str, range: str, registry: str) -> None:
    if len(name) == 0:
        print("nva: install requires a package name")
        exit(1)
    r: str = range
    if len(r) == 0:
        r = "*"

    root: str = registry
    if len(root) == 0:
        cfg: NvaConfig = _config_read()
        root = cfg.registry
    if len(root) == 0:
        root = ".nva_local_registry"
    # No fs.abs: see comment in cmd_publish_local.

    versions: list<str> = _pkg_versions(root, name)
    pick: str = best_match(r, versions)
    from_remote: bool = false

    if len(pick) == 0:
        cfg2: NvaConfig = _config_read()
        remote: str = cfg2.registry_remote
        if len(remote) == 0:
            print("nva: package '" + name + "' not in local registry, no remote configured")
            exit(1)
        _mkdirs(".nva")
        idx_tmp: str = ".nva/remote_index.txt"
        rc: int = _http_get(remote + "/index.txt", idx_tmp)
        if rc != 0 or not file_exists(idx_tmp):
            print("nva: cannot fetch remote index at " + remote)
            exit(1)
        _rmtree(root)
        _mkdirs(root)
        _copy_tree(idx_tmp, root + "/index.txt")
        versions = _pkg_versions(root, name)
        pick = best_match(r, versions)
        from_remote = true
        fs.remove(idx_tmp)
        if len(pick) == 0:
            print("nva: no version of '" + name + "' matches '" + r + "'")
            exit(1)

    dst: str = "nova_modules/" + name
    _rmtree(dst)
    _mkdirs(dst)

    # Phase 23.3 - if the manifest entry for this dep uses git, fetch it.
    if file_exists("nova.toml"):
        rootm: Manifest = parse_manifest("nova.toml")
        j: int = 0
        dep_match: Dep = Dep("", "")
        found_git: bool = false
        while j < len(rootm.deps):
            dj: Dep = rootm.deps[j]
            j = j + 1
            if dj.name == name and len(dj.git) > 0:
                dep_match = dj
                found_git = true
        if found_git:
            rc2: int = _git_clone(dep_match.git, dep_match.git_ref_kind, dep_match.git_ref_value, dst)
            if rc2 == 0:
                print("nva: installed " + name + " from git -> " + dst)
                return
            print("nva: git install failed for " + name)
            exit(1)

    if from_remote:
        cfg3: NvaConfig = _config_read()
        remote3: str = cfg3.registry_remote
        archive: str = ".nva/dl_" + name + "_" + pick + ".tar"
        _mkdirs(".nva")
        url: str = remote3 + "/packages/" + name + "/" + pick + ".tar"
        rc = _http_get(url, archive)
        if rc != 0 or not file_exists(archive):
            print("nva: download failed: " + url)
            exit(1)
        _extract_tar_flat(archive, dst)
        fs.remove(archive)
    else:
        src: str = _pkg_dir(root, name, pick)
        if not fs.exists(src):
            print("nva: index lists " + name + " " + pick + " but directory is missing")
            exit(1)
        _copy_tree(src, dst)

    print("nva: installed " + name + " " + pick + " -> " + dst)

def cmd_publish(remote: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    if len(remote) == 0:
        cfg: NvaConfig = _config_read()
        remote = cfg.registry_remote
    if len(remote) == 0:
        print("nva: no remote configured; pass --remote <url> or set registry_remote")
        exit(1)

    m: Manifest = parse_manifest("nova.toml")
    if len(m.name) == 0 or len(m.version) == 0:
        print("nva: nova.toml missing name or version")
        exit(1)

    _mkdirs(".nva")
    archive: str = ".nva/publish_" + m.name + "_" + m.version + ".tar"
    rc: int = _make_tar(fs.cwd(), archive)
    if rc != 0:
        print("nva: tar creation failed")
        exit(1)

    resp: str = ".nva/publish_response.txt"
    url: str = remote + "/publish"
    rc = _http_post_file(url, archive, resp)
    if rc != 0:
        print("nva: publish POST failed")
        exit(1)
    body: str = read_file(resp)
    print("nva: publish response: " + trim(body))
    fs.remove(archive)
    fs.remove(resp)

def cmd_search_remote(query: str, remote: str) -> None:
    if len(remote) == 0:
        cfg: NvaConfig = _config_read()
        remote = cfg.registry_remote
    if len(remote) == 0:
        print("nva: no remote configured")
        exit(1)
    _mkdirs(".nva")
    idx: str = ".nva/remote_search_index.txt"
    rc: int = _http_get(remote + "/index.txt", idx)
    if rc != 0 or not file_exists(idx):
        print("nva: cannot fetch remote index")
        exit(1)
    src: str = read_file(idx)
    lines: list<str> = src.split("\n")
    count: int = 0
    i: int = 0
    while i < len(lines):
        t: str = trim(lines[i])
        i = i + 1
        if is_blank_or_comment(t):
            continue
        if len(query) > 0 and not t.contains(query):
            continue
        print("  " + t)
        count = count + 1
    fs.remove(idx)
    print("nva: " + str(count) + " remote version(s)")

# ---------------------------------------------------------------------------
# Phase 23.3 + 23.4 commands.
# ---------------------------------------------------------------------------

def cmd_tree() -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m: Manifest = parse_manifest("nova.toml")
    m.root_dir = ""
    visited: list<str> = []
    nodes: list<DepNode> = []
    collect_graph(m, fs.cwd(), visited, 1, nodes)

    print(m.name + " " + m.version)
    i: int = 0
    while i < len(nodes):
        print_tree_node(nodes[i])
        i = i + 1

    conflicts: list<str> = detect_conflicts(nodes)
    if len(conflicts) > 0:
        print("")
        print("nva: version conflicts detected:")
        k: int = 0
        while k < len(conflicts):
            print("  " + conflicts[k])
            k = k + 1

def cmd_add_git(name: str, url: str, ref_kind: str, ref_val: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    if len(name) == 0 or len(url) == 0:
        print("nva: add --git requires a name and a URL")
        exit(1)
    m: Manifest = parse_manifest("nova.toml")
    i: int = 0
    while i < len(m.deps):
        if m.deps[i].name == name:
            print("nva: '" + name + "' is already a dependency")
            exit(1)
        i = i + 1
    toml_add_git_dep("nova.toml", name, url, ref_kind, ref_val)
    suffix: str = ""
    if ref_kind == "tag":
        suffix = " tag " + ref_val
    elif ref_kind == "branch":
        suffix = " branch " + ref_val
    elif ref_kind == "rev":
        suffix = " rev " + ref_val
    print("nva: added " + name + " from git " + url + suffix)

def cmd_update() -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m: Manifest = parse_manifest("nova.toml")
    m.root_dir = ""
    visited: list<str> = []
    nodes: list<DepNode> = []
    collect_graph(m, fs.cwd(), visited, 0, nodes)
    # collect_graph already re-fetches missing git deps.  Force a refresh
    # of every git-sourced dep.
    count: int = 0
    i: int = 0
    while i < len(nodes):
        n: DepNode = nodes[i]
        i = i + 1
        if len(n.git) == 0:
            continue
        dst: str = ""
        if len(n.dir) > 0:
            dst = n.dir
        else:
            dst = "nova_modules/" + n.name
        rc: int = _git_clone(n.git, n.git_ref_kind, n.git_ref_value, dst)
        if rc == 0:
            print("nva: updated " + n.name + "  (" + _depnode_ref_str(n) + ")")
            count = count + 1
        else:
            print("nva: failed to update " + n.name)
    print("nva: " + str(count) + " git dep(s) refreshed")

class Dep:
    name: str
    version: str
    git: str
    git_ref_kind: str
    git_ref_value: str

    def __init__(self, name: str, version: str) -> None:
        self.name = name
        self.version = version
        self.git = ""
        self.git_ref_kind = ""
        self.git_ref_value = ""

class Manifest:
    name: str
    version: str
    author: str
    description: str
    entry: str
    deps: list<Dep>
    root_dir: str
    def __init__(self) -> None:
        self.name = ""
        self.version = "0.1.0"
        self.author = ""
        self.description = ""
        self.entry = "src/main.vyu"
        self.deps = []
        self.root_dir = ""

def trim(s: str) -> str:
    return s.strip()

def is_blank_or_comment(line: str) -> bool:
    t = trim(line)
    if len(t) == 0:
        return true
    if t.starts_with("#"):
        return true
    return false

def join_lines(lines: list<str>) -> str:
    out = ""
    i = 0
    while i < len(lines):
        if i > 0:
            out = out + "\n"
        out = out + lines[i]
        i = i + 1
    return out

def str_in_list(s: str, lst: list<str>) -> bool:
    i = 0
    while i < len(lst):
        if lst[i] == s:
            return true
        i = i + 1
    return false

def parse_manifest(path: str) -> Manifest:
    src = read_file(path)
    lines = src.split("\n")
    m = Manifest()
    section = ""
    i = 0
    while i < len(lines):
        raw = lines[i]
        line = trim(raw)
        i = i + 1
        if is_blank_or_comment(line):
            continue
        if line.starts_with("[") and line.ends_with("]"):
            section = line.substr(1, len(line) - 1)
            continue
        eq = line.find("=")
        if eq < 0:
            continue
        key = trim(line.substr(0, eq))
        val = trim(line.substr(eq + 1, len(line)))
        if val.starts_with("\"") and val.ends_with("\"") and len(val) >= 2:
            val = val.substr(1, len(val) - 1)
        if section == "package":
            if key == "name":
                m.name = val
            if key == "version":
                m.version = val
            if key == "author":
                m.author = val
            if key == "description":
                m.description = val
            if key == "entry":
                m.entry = val
        if section == "dependencies":
            # Two forms:
            #   name = "1.0.0"
            #   name = { git = "url", tag = "v1", branch = "main", rev = "abc" }
            if val.starts_with("{"):
                d: Dep = Dep(key, "")
                inner: str = val.substr(1, len(val) - 1)
                if inner.ends_with("}"):
                    inner = inner.substr(0, len(inner) - 1)
                fields: list<str> = inner.split(",")
                j: int = 0
                while j < len(fields):
                    f: str = trim(fields[j])
                    if len(f) > 0:
                        eq2: int = f.find("=")
                        if eq2 > 0:
                            k2: str = trim(f.substr(0, eq2))
                            v2: str = trim(f.substr(eq2 + 1, len(f)))
                            if v2.starts_with("\"") and v2.ends_with("\"") and len(v2) >= 2:
                                v2 = v2.substr(1, len(v2) - 1)
                            if k2 == "git":
                                d.git = v2
                            elif k2 == "version":
                                d.version = v2
                            elif k2 == "tag":
                                d.git_ref_kind = "tag"
                                d.git_ref_value = v2
                            elif k2 == "branch":
                                d.git_ref_kind = "branch"
                                d.git_ref_value = v2
                            elif k2 == "rev":
                                d.git_ref_kind = "rev"
                                d.git_ref_value = v2
                    j = j + 1
                m.deps.append(d)
            else:
                m.deps.append(Dep(key, val))
    return m

def join_path(a: str, b: str) -> str:
    if len(a) == 0:
        return b
    if a.ends_with("/") or a.ends_with("\\"):
        return a + b
    return a + "/" + b

def dir_exists(p: str) -> bool:
    rc = run_command("dir \"" + p + "\" /ad /b >nul 2>nul")
    if rc == 0:
        return true
    return false

def mkdir(p: str) -> None:
    run_command("mkdir \"" + p + "\" 2>nul")

def find_up(rel_path: str) -> str:
    if file_exists(rel_path):
        return rel_path
    p1 = "..\\" + rel_path
    if file_exists(p1):
        return p1
    p2 = "..\\..\\" + rel_path
    if file_exists(p2):
        return p2
    p3 = "..\\..\\..\\" + rel_path
    if file_exists(p3):
        return p3
    p4 = "..\\..\\..\\..\\" + rel_path
    if file_exists(p4):
        return p4
    p5 = "..\\..\\..\\..\\..\\" + rel_path
    if file_exists(p5):
        return p5
    p6 = "..\\..\\..\\..\\..\\..\\" + rel_path
    if file_exists(p6):
        return p6
    return ""

def find_vayuc() -> str:
    p = find_up("build\\x64-debug\\bin\\vayuc.exe")
    if p == "":
        return "vayuc.exe"
    return p

def find_qbe() -> str:
    return find_up("tools\\qbe.exe")

def find_dep_dir(name: str, root: str) -> str:
    p1 = join_path(join_path(root, "nova_modules"), name)
    if dir_exists(p1):
        return p1
    p2 = join_path(join_path(root, ".."), name)
    if dir_exists(p2):
        return p2
    return ""

def resolve_modules(m: Manifest) -> str:
    parts: list<str> = []
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        ddir = find_dep_dir(d.name, m.root_dir)
        if ddir == "":
            print("nva: missing dependency '" + d.name + "'")
            exit(1)
        parts.append(ddir)
        sub_toml = join_path(ddir, "nova.toml")
        if file_exists(sub_toml):
            sub = parse_manifest(sub_toml)
            sub.root_dir = ddir
            j = 0
            while j < len(sub.deps):
                sd = sub.deps[j]
                sdir = find_dep_dir(sd.name, ddir)
                if sdir != "":
                    parts.append(sdir)
                j = j + 1
        i = i + 1
    out = ""
    k = 0
    while k < len(parts):
        if k > 0:
            out = out + ";"
        out = out + parts[k]
        k = k + 1
    return out

# ---------------------------------------------------------------------------
# lib folder / lib.zip management
# ---------------------------------------------------------------------------

def extract_lib_zip() -> None:
    print("nva: extracting " + LIB_ZIP + " ...")
    # Expand-Archive requires PowerShell 5+; DestinationPath '.' puts
    # the top-level folder (lib/) back in the current directory.
    cmd = "powershell -NoProfile -Command \"Expand-Archive -Path '" + LIB_ZIP + "' -DestinationPath '.' -Force\""
    rc = run_command(cmd)
    if rc != 0:
        print("nva: failed to extract " + LIB_ZIP)
        exit(1)

def download_lib_zip() -> bool:
    print("nva: downloading " + LIB_ZIP + " ...")
    # Prefer curl.exe (ships with Windows 10+).
    rc = run_command("curl -L -s -o " + LIB_ZIP + " \"" + LIB_ZIP_URL + "\"")
    if rc != 0:
        # Fallback: PowerShell Invoke-WebRequest.
        cmd = "powershell -NoProfile -Command \"Invoke-WebRequest -UseBasicParsing -Uri '" + LIB_ZIP_URL + "' -OutFile '" + LIB_ZIP + "'\""
        rc = run_command(cmd)
    return rc == 0

def ensure_lib() -> None:
    # Fast path — lib/ already present, nothing to do.
    if dir_exists(LIB_DIR):
        return
    # lib.zip present — extract and go.
    if file_exists(LIB_ZIP):
        extract_lib_zip()
        return
    # Neither present — ask.
    print("nva: lib/ is missing and lib.zip was not found.")
    print("nva: download lib.zip from GitHub? (Y/N)")
    ans = read_line().strip()
    if ans == "Y" or ans == "y":
        if not download_lib_zip():
            print("nva: download failed.")
            exit(1)
        extract_lib_zip()
    else:
        print("nva: cancelled — lib/ is required to build.")
        exit(1)

# ---------------------------------------------------------------------------
# toml editing
# ---------------------------------------------------------------------------

def toml_add_dep(path: str, name: str, version: str) -> None:
    src = read_file(path)
    lines = src.split("\n")
    dep_start = -1
    dep_end = -1
    i = 0
    while i < len(lines):
        t = trim(lines[i])
        if t == "[dependencies]":
            dep_start = i
            j = i + 1
            while j < len(lines):
                u = trim(lines[j])
                if u.starts_with("[") and u.ends_with("]"):
                    break
                if len(u) > 0:
                    dep_end = j
                j = j + 1
            break
        i = i + 1

    new_line = name + " = \"" + version + "\""
    new_lines: list<str> = []
    if dep_start < 0:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            k = k + 1
        new_lines.append("")
        new_lines.append("[dependencies]")
        new_lines.append(new_line)
    elif dep_end < 0:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_start:
                new_lines.append(new_line)
            k = k + 1
    else:
        k = 0
        while k < len(lines):
            new_lines.append(lines[k])
            if k == dep_end:
                new_lines.append(new_line)
            k = k + 1
    write_file(path, join_lines(new_lines))

def toml_remove_dep(path: str, name: str) -> None:
    src = read_file(path)
    lines = src.split("\n")
    in_deps = false
    out_lines: list<str> = []
    i = 0
    while i < len(lines):
        line = lines[i]
        t = trim(line)
        if t == "[dependencies]":
            in_deps = true
            out_lines.append(line)
            i = i + 1
            continue
        if in_deps and t.starts_with("[") and t.ends_with("]"):
            in_deps = false
        if in_deps and len(t) > 0:
            eq = t.find("=")
            if eq >= 0:
                key = trim(t.substr(0, eq))
                if key == name:
                    i = i + 1
                    continue
        out_lines.append(line)
        i = i + 1
    write_file(path, join_lines(out_lines))

# ---------------------------------------------------------------------------
# lock file
# ---------------------------------------------------------------------------

def collect_lock_entries(m: Manifest, out: list<str>, visited: list<str>) -> None:
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        if not str_in_list(d.name, visited):
            visited.append(d.name)
            ddir = find_dep_dir(d.name, m.root_dir)
            out.append(d.name + " " + d.version + " " + ddir)
            sub_toml = join_path(ddir, "nova.toml")
            if file_exists(sub_toml):
                sub = parse_manifest(sub_toml)
                sub.root_dir = ddir
                collect_lock_entries(sub, out, visited)
        i = i + 1

def write_lock(m: Manifest) -> None:
    lines: list<str> = []
    lines.append("# nva lock file, format v1")
    lines.append("# do not edit by hand; regenerate with 'nva build'")
    lines.append("# fields: name version path")
    visited: list<str> = []
    collect_lock_entries(m, lines, visited)
    write_file("nova.lock", join_lines(lines) + "\n")

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_new(name: str) -> None:
    root = name
    mkdir(root)
    mkdir(join_path(root, "src"))
    toml = "[package]\n"
    toml = toml + "name = \"" + name + "\"\n"
    toml = toml + "version = \"0.1.0\"\n"
    toml = toml + "author = \"\"\n"
    toml = toml + "description = \"\"\n"
    toml = toml + "entry = \"src/main.vyu\"\n"
    toml = toml + "\n"
    toml = toml + "[dependencies]\n"
    write_file(join_path(root, "nova.toml"), toml)
    main_src = "print(\"Hello from " + name + "!\")\n"
    write_file(join_path(root, "src/main.vyu"), main_src)
    print("nva: created project '" + name + "'")
    print("     cd " + name)
    print("     nva run")

def cmd_init() -> None:
    toml = "[package]\n"
    toml = toml + "name = \"app\"\n"
    toml = toml + "version = \"0.1.0\"\n"
    toml = toml + "author = \"\"\n"
    toml = toml + "description = \"\"\n"
    toml = toml + "entry = \"src/main.vyu\"\n"
    toml = toml + "\n"
    toml = toml + "[dependencies]\n"
    write_file("nova.toml", toml)
    mkdir("src")
    if not file_exists("src/main.vyu"):
        write_file("src/main.vyu", "print(\"Hello, Vayu!\")\n")
    print("nva: initialized nova.toml")

def cmd_add(name: str, version: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    i = 0
    while i < len(m.deps):
        if m.deps[i].name == name:
            print("nva: '" + name + "' is already a dependency")
            exit(1)
        i = i + 1
    toml_add_dep("nova.toml", name, version)
    print("nva: added " + name + " = \"" + version + "\"")

def cmd_remove(name: str) -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    found = false
    i = 0
    while i < len(m.deps):
        if m.deps[i].name == name:
            found = true
        i = i + 1
    toml_remove_dep("nova.toml", name)
    if found:
        print("nva: removed " + name)
    else:
        print("nva: '" + name + "' was not a dependency")

def print_dep_tree(m: Manifest, indent: int, visited: list<str>) -> None:
    pad = ""
    k = 0
    while k < indent:
        pad = pad + "  "
        k = k + 1
    i = 0
    while i < len(m.deps):
        d = m.deps[i]
        if str_in_list(d.name, visited):
            print(pad + d.name + " " + d.version + " (already shown)")
            i = i + 1
            continue
        visited.append(d.name)
        ddir = find_dep_dir(d.name, m.root_dir)
        if ddir == "":
            print(pad + d.name + " " + d.version + " (MISSING)")
        else:
            print(pad + d.name + " " + d.version + " -> " + ddir)
            sub_toml = join_path(ddir, "nova.toml")
            if file_exists(sub_toml):
                sub = parse_manifest(sub_toml)
                sub.root_dir = ddir
                print_dep_tree(sub, indent + 1, visited)
        i = i + 1

def cmd_list() -> None:
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    m.root_dir = ""
    if m.name == "":
        print("nva: nova.toml has no package.name")
        exit(1)
    print(m.name + " " + m.version)
    if len(m.deps) == 0:
        print("  (no dependencies)")
        return
    visited: list<str> = []
    print_dep_tree(m, 1, visited)

def cmd_build() -> str:
    ensure_lib()
    if not file_exists("nova.toml"):
        print("nva: no nova.toml in this directory")
        exit(1)
    m = parse_manifest("nova.toml")
    m.root_dir = ""
    if m.name == "":
        print("nva: nova.toml has no package.name")
        exit(1)
    mod_path = resolve_modules_full(m, fs.cwd())
    mkdir("build")

    entry_win = m.entry.replace("/", "\\")
    exe_win = "build\\" + m.name + ".exe"

    compiler = find_vayuc()
    if compiler == "vayuc.exe":
        print("nva: warning: vayuc.exe not found in build/x64-debug/bin")
        print("nva: falling back to PATH lookup")

    qbe = find_qbe()
    if qbe == "":
        print("nva: warning: tools/qbe.exe not found by walking up")

    prefix = ""
    if len(mod_path) > 0:
        mod_path_win = mod_path.replace("/", "\\")
        prefix = prefix + "set \"VAYU_MODULE_PATH=" + mod_path_win + "\" && "
    if len(qbe) > 0:
        prefix = prefix + "set \"VAYU_QBE=" + qbe + "\" && "
    run_part = "call \"" + compiler + "\" \"" + entry_win + "\" --native-out \"" + exe_win + "\""
    cmd = prefix + run_part

    print("nva: building " + m.name + " ...")
    rc = run_command(cmd)
    if rc != 0:
        print("nva: build failed (exit " + str(rc) + ")")
        exit(1)
    write_lock(m)
    print("nva: built " + exe_win)
    return exe_win

def cmd_run() -> None:
    exe = cmd_build()
    print("nva: running " + exe)
    run_command("\"" + exe + "\"")

def cmd_clean() -> None:
    if dir_exists("build"):
        run_command("rmdir /s /q build 2>nul")
    if file_exists("nova.lock"):
        print("nva: kept nova.lock (regenerated on next build)")
    print("nva: cleaned")

def main() -> None:
    a = args()
    if len(a) < 1:
        print("usage: nva <command> [args]")
        print("       nva new <name>")
        print("       nva init")
        print("       nva add <name> [version]")
        print("       nva remove <name>")
        print("       nva list")
        print("       nva build")
        print("       nva run")
        print("       nva clean")
        print("")
        print("registry:")
        print("       nva registry [--set <path>]")
        print("       nva registry-remote [--set <url>]")
        print("       nva publish-local [--registry <path>]")
        print("       nva publish [--remote <url>]")
        print("       nva install <name> [range] [--registry <path>]")
        print("       nva search <query> [--registry <path>]")
        print("       nva search-remote <query> [--remote <url>]")
        print("")
        print("git deps + solver:")
        print("       nva add-git <name> <url> [--tag|--branch|--rev <value>]")
        print("       nva tree")
        print("       nva update")
        print("")
        print("utility:")
        print("       nva semver-test")
        exit(1)
    cmd = a[0]
    if cmd == "new":
        if len(a) < 2:
            print("nva: 'new' requires a project name")
            exit(1)
        cmd_new(a[1])
        return
    if cmd == "init":
        cmd_init()
        return
    if cmd == "add":
        if len(a) < 2:
            print("nva: 'add' requires a package name")
            exit(1)
        ver = "0.1.0"
        if len(a) >= 3:
            ver = a[2]
        cmd_add(a[1], ver)
        return
    if cmd == "remove":
        if len(a) < 2:
            print("nva: 'remove' requires a package name")
            exit(1)
        cmd_remove(a[1])
        return
    if cmd == "list":
        cmd_list()
        return
    if cmd == "build":
        cmd_build()
        return
    if cmd == "run":
        cmd_run()
        return
    if cmd == "clean":
        cmd_clean()
        return
    if cmd == "semver-test":
        # Quick self-test of version resolution.  Prints PASS/FAIL lines.
        tc: SemverTest = SemverTest()

        tc.check("^1.2.3 matches 1.5.0", version_matches("^1.2.3", "1.5.0"), true)
        tc.check("^1.2.3 matches 1.2.3", version_matches("^1.2.3", "1.2.3"), true)
        tc.check("^1.2.3 rejects 2.0.0", version_matches("^1.2.3", "2.0.0"), false)
        tc.check("^1.2.3 rejects 1.1.0", version_matches("^1.2.3", "1.1.0"), false)
        tc.check("^0.3.5 matches 0.3.9", version_matches("^0.3.5", "0.3.9"), true)
        tc.check("^0.3.5 rejects 0.4.0", version_matches("^0.3.5", "0.4.0"), false)
        tc.check("~1.2.3 matches 1.2.9", version_matches("~1.2.3", "1.2.9"), true)
        tc.check("~1.2.3 rejects 1.3.0", version_matches("~1.2.3", "1.3.0"), false)
        tc.check(">=1.0.0 matches 5.0.0", version_matches(">=1.0.0", "5.0.0"), true)
        tc.check("<2.0.0 rejects 2.0.0", version_matches("<2.0.0", "2.0.0"), false)
        tc.check("* matches anything", version_matches("*", "0.0.1"), true)
        tc.check("exact 1.2.3 matches 1.2.3", version_matches("1.2.3", "1.2.3"), true)
        tc.check("exact 1.2.3 rejects 1.2.4", version_matches("1.2.3", "1.2.4"), false)

        cands: list<str> = ["1.0.0", "1.2.0", "1.2.5", "1.9.0", "2.0.0"]
        bm: str = best_match("^1.0.0", cands)
        tc.check("best_match ^1.0.0 -> 1.9.0", bm == "1.9.0", true)

        print("")
        print("  " + str(tc.passes) + " passed, " + str(tc.fails) + " failed")
        if tc.fails > 0:
            exit(1)
        return

    if cmd == "registry":
        cmd_registry(_flag_value(a, "--set"))
        return
    if cmd == "registry-remote":
        cmd_registry_remote(_flag_value(a, "--set"))
        return
    if cmd == "publish-local":
        cmd_publish_local(_flag_value(a, "--registry"))
        return
    if cmd == "publish":
        cmd_publish(_flag_value(a, "--remote"))
        return
    if cmd == "install":
        if len(a) < 2:
            print("nva: install requires a package name")
            exit(1)
        pkg_name: str = a[1]
        ver_range: str = "*"
        i: int = 2
        while i < len(a):
            if a[i].starts_with("--"):
                i = i + 2
                continue
            ver_range = a[i]
            i = i + 1
        cmd_install(pkg_name, ver_range, _flag_value(a, "--registry"))
        return
    if cmd == "search":
        if len(a) < 2:
            print("nva: search requires a query")
            exit(1)
        cmd_search(a[1], _flag_value(a, "--registry"))
        return
    if cmd == "search-remote":
        if len(a) < 2:
            print("nva: search-remote requires a query")
            exit(1)
        cmd_search_remote(a[1], _flag_value(a, "--remote"))
        return
    if cmd == "tree":
        cmd_tree()
        return
    if cmd == "update":
        cmd_update()
        return
    if cmd == "add-git":
        if len(a) < 3:
            print("nva: add-git <name> <url> [--tag|--branch|--rev <value>]")
            exit(1)
        url0: str = a[2]
        rk: str = ""
        rv: str = ""
        if _flag_value(a, "--tag") != "":
            rk = "tag"
            rv = _flag_value(a, "--tag")
        elif _flag_value(a, "--branch") != "":
            rk = "branch"
            rv = _flag_value(a, "--branch")
        elif _flag_value(a, "--rev") != "":
            rk = "rev"
            rv = _flag_value(a, "--rev")
        cmd_add_git(a[1], url0, rk, rv)
        return

    print("nva: unknown command '" + cmd + "'")
    exit(1)

main()