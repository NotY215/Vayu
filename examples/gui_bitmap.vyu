# examples/gui_bitmap.vyu -- Phase 20.2 demo (codec-free path).
# Builds a checker bitmap in memory, then draws it four ways.

import gui

const EV_PAINT: int = 1
const EV_CLOSE: int = 7
const EV_TIMER: int = 8

const W: int = 520
const H: int = 400
const TEX_W: int = 256
const TEX_H: int = 256

bmp: int = 0

def make_checker() -> int:
    px: list<int> = []
    y: int = 0
    while y < TEX_H:
        x: int = 0
        while x < TEX_W:
            cx: int = x // 32
            cy: int = y // 32
            if (cx + cy) % 2 == 0:
                px.append(0xFF3366CC)
            else:
                px.append(0xFFFFFFFF)
            x = x + 1
        y = y + 1
    return gui.bitmap_from_pixels(TEX_W, TEX_H, px)

def on_event(ev: int) -> None:
    if ev == EV_CLOSE:
        if bmp != 0:
            gui.bitmap_free(bmp)
        gui.quit()
        return
    if ev == EV_TIMER:
        gui.quit()
        return
    if ev != EV_PAINT:
        return
    c: int = gui.canvas_from_window()
    gui.canvas_clear(c, 0xFF202028)
    if bmp != 0:
        gui.draw_bitmap(c, bmp, 10, 10)
        gui.draw_bitmap_scaled(c, bmp, 280, 10, 220, 180)
        gui.draw_bitmap_alpha(c, bmp, 10, 280, 96)
        gui.draw_bitmap_part(c, bmp, 0, 0, 128, 128, 280, 210)
    gui.canvas_free(c)

def main() -> None:
    gui.init()
    bmp = make_checker()
    if bmp == 0:
        print("failed to build bitmap")
        exit(1)
    print("bitmap: " + str(gui.bitmap_width(bmp)) + "x" + str(gui.bitmap_height(bmp)))
    win: int = gui.create_window("Vayu bitmaps", W, H)
    gui.set_callback(&on_event)
    gui.show_window(win)
    gui.set_timer(1500)
    gui.run(win)
    if bmp != 0:
        gui.bitmap_free(bmp)
    print("bitmap demo done")

main()