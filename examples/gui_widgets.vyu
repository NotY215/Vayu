import gui

class Widget:
    kind: int
    x: int
    y: int
    w: int
    h: int
    visible: bool
    text: str
    color: int
    bg: int
    fg: int
    hover_bg: int
    press_bg: int
    border: int
    pressed: bool
    on_click: int
    handle: int

    def __init__(self) -> None:
        self.kind = 0
        self.x = 0
        self.y = 0
        self.w = 0
        self.h = 0
        self.visible = true
        self.text = ""
        self.color = 0xE0E0E0
        self.bg = 0x3A3A3A
        self.fg = 0xFFFFFF
        self.hover_bg = 0x505050
        self.press_bg = 0x2A6EBB
        self.border = 0x808080
        self.pressed = false
        self.on_click = 0
        self.handle = 0

    def contains(self, mx: int, my: int) -> bool:
        if gui.rect_hit(self.x, self.y, self.w, self.h, mx, my) == 1:
            return true
        return false

    def draw(self) -> None:
        if not self.visible:
            return
        if self.kind == 1:
            pad_y: int = (self.h - 14) // 2
            gui.text(self.text, self.x + 2, self.y + pad_y, self.color)
        elif self.kind == 2:
            c: int = self.bg
            if self.pressed:
                c = self.press_bg
            elif self.contains(gui.mouse_x(), gui.mouse_y()):
                c = self.hover_bg
            gui.fill_rect(self.x, self.y, self.w, self.h, c)
            gui.outline_rect(self.x, self.y, self.w, self.h, self.border)
            text_w: int = len(self.text) * 7
            tx: int = self.x + (self.w - text_w) // 2
            ty: int = self.y + (self.h - 12) // 2
            gui.text(self.text, tx, ty, self.fg)

    def on_mouse_down(self, mx: int, my: int) -> None:
        if self.kind == 2:
            if self.contains(mx, my):
                self.pressed = true

    def on_mouse_up(self, mx: int, my: int) -> None:
        if self.kind == 2:
            was: bool = self.pressed
            self.pressed = false
            if was:
                if self.contains(mx, my):
                    self.on_click = 1


def make_label(x: int, y: int, w: int, h: int, t: str) -> Widget:
    wd: Widget = Widget()
    wd.kind = 1
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.text = t
    return wd

def make_button(x: int, y: int, w: int, h: int, t: str) -> Widget:
    wd: Widget = Widget()
    wd.kind = 2
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.text = t
    return wd

def make_input(parent: int, x: int, y: int, w: int, h: int) -> Widget:
    wd: Widget = Widget()
    wd.kind = 3
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.handle = gui.create_input(parent, x, y, w, h)
    return wd

def make_checkbox(parent: int, x: int, y: int, w: int, h: int, t: str) -> Widget:
    wd: Widget = Widget()
    wd.kind = 4
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.text = t
    wd.handle = gui.create_checkbox(parent, x, y, w, h, t)
    return wd

def make_slider(parent: int, x: int, y: int, w: int, h: int) -> Widget:
    wd: Widget = Widget()
    wd.kind = 5
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.handle = gui.create_slider(parent, x, y, w, h)
    return wd

def make_listbox(parent: int, x: int, y: int, w: int, h: int) -> Widget:
    wd: Widget = Widget()
    wd.kind = 6
    wd.x = x
    wd.y = y
    wd.w = w
    wd.h = h
    wd.handle = gui.create_listbox(parent, x, y, w, h)
    return wd


w_handle: int = 0
btn_ok: Widget = Widget()
btn_clear: Widget = Widget()
input_name: Widget = Widget()
lbl_status: Widget = Widget()
chk: Widget = Widget()
sld: Widget = Widget()
lst: Widget = Widget()
lbl_slider_val: Widget = Widget()
lbl_list_sel: Widget = Widget()
lbl_check_state: Widget = Widget()
widgets: list<Widget> = []

def refresh_all() -> None:
    lbl_slider_val.text = "slider: " + str(gui.slider_get(sld.handle))
    idx: int = gui.listbox_index(lst.handle)
    if idx < 0:
        lbl_list_sel.text = "list: (nothing selected)"
    else:
        lbl_list_sel.text = "list: " + gui.listbox_get(lst.handle, idx)
    if gui.checkbox_get(chk.handle) == 1:
        lbl_check_state.text = "checkbox: ON"
    else:
        lbl_check_state.text = "checkbox: OFF"

def do_greet() -> None:
    name: str = gui.input_get(input_name.handle)
    if len(name) == 0:
        lbl_status.text = "status: enter a name first"
    else:
        lbl_status.text = "status: hello, " + name + "!"

def on_event(ev: int) -> None:
    if ev == gui.EV_PAINT:
        gui.clear(0x1E1E1E)
        gui.text("Vayu widgets - phase 19.3", 20, 12, 0xFFFFFF)
        gui.line(20, 40, 620, 40, 0x404040)
        for wid in widgets:
            wid.draw()
    elif ev == gui.EV_MOUSE_DOWN:
        mx: int = gui.mouse_x()
        my: int = gui.mouse_y()
        for wid in widgets:
            wid.on_mouse_down(mx, my)
    elif ev == gui.EV_MOUSE_UP:
        mx: int = gui.mouse_x()
        my: int = gui.mouse_y()
        for wid in widgets:
            wid.on_mouse_up(mx, my)
        if btn_ok.on_click == 1:
            btn_ok.on_click = 0
            do_greet()
        if btn_clear.on_click == 1:
            btn_clear.on_click = 0
            gui.input_set(input_name.handle, "")
            gui.input_focus(input_name.handle)
            lbl_status.text = "status: cleared"
        refresh_all()
    elif ev == gui.EV_KEY_DOWN:
        if gui.last_key() == 27:
            gui.quit()
    elif ev == gui.EV_ENTER:
        do_greet()
    elif ev == gui.EV_CONTROL:
        refresh_all()
    elif ev == gui.EV_MOUSE_WHEEL:
        delta: int = gui.wheel_delta()
        step: int = 5
        if delta < 0:
            step = 0 - 5
        cur: int = gui.slider_get(sld.handle)
        nv: int = cur + step
        if nv < 0:
            nv = 0
        if nv > 100:
            nv = 100
        gui.slider_set(sld.handle, nv)
        refresh_all()
    elif ev == gui.EV_RESIZE:
        lbl_status.text = "status: window " + str(gui.window_w()) + "x" + str(gui.window_h())
    elif ev == gui.EV_CLOSE:
        gui.quit()

def main() -> None:
    gui.init()
    w_handle = gui.create_window("Vayu widgets", 660, 460)

    # Callback BEFORE show so the first paint has something to draw.
    gui.set_callback(&on_event)

    lbl_name: Widget = make_label(20, 78, 200, 20, "Name:")
    widgets.append(lbl_name)

    input_name = make_input(w_handle, 20, 100, 300, 28)
    widgets.append(input_name)

    btn_ok = make_button(340, 100, 120, 28, "Greet")
    widgets.append(btn_ok)

    btn_clear = make_button(470, 100, 120, 28, "Clear")
    widgets.append(btn_clear)

    lbl_status = make_label(20, 150, 620, 20, "status: ready")
    widgets.append(lbl_status)

    chk = make_checkbox(w_handle, 20, 190, 240, 22, "Enable feature")
    widgets.append(chk)

    lbl_check_state = make_label(280, 190, 200, 20, "checkbox: OFF")
    widgets.append(lbl_check_state)

    lbl_slider: Widget = make_label(20, 232, 260, 20, "Slider (0-100)")
    widgets.append(lbl_slider)

    sld = make_slider(w_handle, 20, 254, 400, 20)
    widgets.append(sld)

    lbl_slider_val = make_label(440, 254, 200, 20, "slider: 0")
    widgets.append(lbl_slider_val)

    lbl_list: Widget = make_label(20, 296, 260, 20, "Pick a fruit:")
    widgets.append(lbl_list)

    lst = make_listbox(w_handle, 20, 318, 200, 100)
    widgets.append(lst)
    gui.listbox_add(lst.handle, "apple")
    gui.listbox_add(lst.handle, "banana")
    gui.listbox_add(lst.handle, "cherry")
    gui.listbox_add(lst.handle, "date")
    gui.listbox_add(lst.handle, "elderberry")

    lbl_list_sel = make_label(240, 318, 400, 20, "list: (nothing selected)")
    widgets.append(lbl_list_sel)

    lbl_hint: Widget = make_label(20, 428, 620, 20, "Enter = greet | Wheel = slider | ESC = quit")
    lbl_hint.color = 0x808080
    widgets.append(lbl_hint)

    gui.show_window(w_handle)
    gui.run(w_handle)
    gui.close(w_handle)

main()