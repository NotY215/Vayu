# if/elif/else
x = 7
if x < 0:
    print("negative")
elif x == 0:
    print("zero")
elif x < 10:
    print("small")
else:
    print("big")

# while
i = 5
while i > 0:
    print(i)
    i = i - 1

# for over range
for n in range(5):
    print(n)

# for over list
for color in ["red", "green", "blue"]:
    print(color)

# nested for
for i in range(3):
    for j in range(2):
        print(i * 10 + j)

# for with break (uses only supported ops)
found = false
for n in range(100):
    if n == 5:
        found = true
    if found:
        print("found at", n)

# sum via for loop
total = 0
for n in range(1, 11):
    total = total + n
print("sum 1..10 =", total)

# string iteration via list conversion is not in VM yet -- skip it
# (list("abc") would need ATTRIBUTE/CALL on list -- arrives in 4F)

print("done")