# self_host_17.vyu — Phase 17.2: bitwise + compound bitwise.

a: int = 12
b: int = 10
print(a & b)      # 8
print(a | b)      # 14
print(a ^ b)      # 6
print(a << 2)     # 48
print(a >> 1)     # 6
print(~a)         # -13

c: int = 12
c &= 10           # 8
c |= 1            # 9
c ^= 3            # 10
c <<= 1           # 20
c >>= 2           # 5
print(c)

d: int = 3
d **= 2           # 9
d //= 2           # 4
print(d)