extern "C":
    def llabs(x: int) -> int

class Point:
    x: int
    y: int
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y

def main() -> None:
    r = llabs(0 - 42)
    print(r)

    unsafe:
        x: int = 10
        p = &x
        print(*p)
        *p = 20
        print(x)

    unsafe:
        arr: list<int> = [1, 2, 3]
        q = &arr[1]
        print(*q)
        *q = 99
        print(arr[1])

    unsafe:
        pt = Point(5, 7)
        pf = &pt.x
        print(*pf)
        *pf = 55
        print(pt.x)

main()