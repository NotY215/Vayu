# examples/gui_image_io.vyu -- Phase 20.5 demo.
# WIC PNG round-trip: build, save, reload, draw.

import gui
import fs

const EV_PAINT: int = 1
const EV_CLOSE: int = 7
const EV_TIMER: int = 8

const W: int = 620
const H: int = 400
const TEX_W: int = 200
const TEX_H: int = 200
const TMP: str = "vayu_wic_demo.png"

bmp: int = 0

def build_gradient() -> int:
    px: list<int> = []
    y: int = 0
    while y < TEX_H:
        x: int = 0
        while x < TEX_W:
            r: int = (x * 255) // TEX_W
            g: int = (y * 255) // TEX_H
            b: int = 128
            argb: int = (255 << 24) | (r << 16) | (g << 8) | b
            px.append(argb)
            x = x + 1
        y = y + 1
    return gui.bitmap_from_pixels(TEX_W, TEX_H, px)

def on_event(ev: int) -> None:
    if ev == EV_CLOSE:
        if bmp != 0:
            gui.bitmap_free(bmp)
        fs.remove(TMP)
        gui.quit()
        return
    if ev == EV_TIMER:
        gui.quit()
        return
    if ev != EV_PAINT:
        return
    c: int = gui.canvas_from_window()
    gui.canvas_clear(c, 0xFF202028)
    if bmp != 0:
        gui.draw_bitmap(c, bmp, 20, 20)
        gui.draw_bitmap_scaled(c, bmp, 240, 20, 160, 160)
        gui.draw_bitmap_scaled(c, bmp, 420, 20, 180, 180)
        gui.draw_bitmap_alpha(c, bmp, 20, 240, 140)
        gui.draw_bitmap_part(c, bmp, 40, 40, 120, 120, 240, 240)
    gui.canvas_free(c)

def main() -> None:
    print("[dbg] cwd path resolves to: " + fs.abs(TMP))
    gui.init()
    src: int = build_gradient()
    print("[dbg] gradient handle = " + str(src))
    if src == 0:
        print("failed to build gradient")
        exit(1)

    # Save via WIC, then reload via WIC.
    tmpcanvas: int = gui.canvas_new(TEX_W, TEX_H)
    print("[dbg] canvas handle = " + str(tmpcanvas))
    gui.canvas_clear(tmpcanvas, 0xFF000000)
    gui.draw_bitmap(tmpcanvas, src, 0, 0)
    ok: int = gui.canvas_save_png(tmpcanvas, TMP)
    print("[dbg] canvas_save_png returned " + str(ok))
    gui.canvas_free(tmpcanvas)
    gui.bitmap_free(src)
    if ok == 0:
        print("failed to save PNG via WIC")
        exit(1)
    print("saved " + TMP)
    print("[dbg] file exists after save? " + str(fs.exists(TMP)))

    bmp = gui.bitmap_load(TMP)
    print("[dbg] bitmap_load returned " + str(bmp))
    if bmp == 0:
        print("failed to reload PNG via WIC")
        fs.remove(TMP)
        exit(1)
    print("reloaded: " + str(gui.bitmap_width(bmp)) + "x" + str(gui.bitmap_height(bmp)))

    win: int = gui.create_window("Vayu WIC image I/O", W, H)
    gui.set_callback(&on_event)
    gui.show_window(win)
    gui.set_timer(1500)
    gui.run(win)
    if bmp != 0:
        gui.bitmap_free(bmp)
    fs.remove(TMP)
    print("image io demo done")

main()