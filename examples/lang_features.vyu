namespace Math:
    const PI = 3
    def square(x: int) -> int:
        return x * x

class Resource:
    name: str
    def __init__(self, name: str) -> None:
        self.name = name
    def __enter__(self) -> int:
        print("enter " + self.name)
        return 42
    def __exit__(self) -> None:
        print("exit " + self.name)

def describe(n: int) -> str:
    match n:
        case 0:
            return "zero"
        case 1:
            return "one"
        case x if x < 0:
            return "negative"
        case _:
            return "many"

def process(a: int, b: int) -> None:
    defer print("defer-second")
    defer print("defer-first")
    print("processing " + str(a + b))

def main() -> None:
    print(Math.PI)
    print(Math.square(5))

    print(describe(0))
    print(describe(1))
    print(describe(-3))
    print(describe(7))

    with Resource("first") as v:
        print("inside, v = " + str(v))

    process(10, 20)

    match (10, 20):
        case (x, y):
            print(x + y)

main()

# ============================================================
# Constants and enums, combined from const_enum.vyu.
# ============================================================

const PI = 3
const MAX: int = 100

enum Color:
    Red
    Green
    Blue

enum Status:
    Pending
    Active = 10
    Closed = 20

def area(r: int) -> int:
    return PI * r * r

def constants_main() -> None:
    print(area(2))
    print(MAX)
    print(Color.Red)
    print(Color.Green)
    print(Color.Blue)
    print(Status.Pending)
    print(Status.Active)
    print(Status.Closed)
    c = Color.Green
    if c == 1:
        print("green is 1")
    if Status.Closed > Status.Active:
        print("closed > active")

constants_main()

# ============================================================
# Type inference, annotations, promotions, and return types, combined from types.vyu.
# ============================================================

# Types that should all pass

x = 5
y = 3.14
name = "NotY"
flag = true

# Inference
a: int = 10
b: float = 2.5
c: str = "hello"

# Promotion
promoted = a + b           # float

# Arithmetic
n = a * 2
d = a / 2                  # float
f = a // 2                 # int
m = a % 3                  # int
p = 2 ** 10                # int
s = "a" * 3                # str

# Comparisons → bool
check = a > 5
equal = a == 10
notEq = a != 0

# Logical
ok = flag and check
either = flag or notEq

# Function with proper types
def add(p: int, q: int) -> int:
    return p + q

def scale(v: float, k: float) -> float:
    return v * k

r1 = add(1, 2)
r2 = scale(1.5, 2.0)
r3 = scale(1, 2.0)         # int → float promotion OK

# Function that uses another function
def twice(n: int) -> int:
    return add(n, n)

r4 = twice(21)

# Empty return
def noop():
    return

print("All type checks passed.")
print(r1, r2, r3, r4)
