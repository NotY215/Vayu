# vcb_strings.vyu -- exercises bool printing, string literals, and
# string methods through the VCB backend.
#
# Expected stdout:
#   3 4
#   7
#   true
#   false
#   hello, world
#   12
#   HELLO, WORLD
#   hello, world
#   true
#   false
#   true
#   7
#   42
#
# Expected exit code: 0

x: int = 3
y: int = 4
print(x, y)
print(x + y)
print(x < y)
print(x > y)
print("hello, world")
print("hello, world".len())
print("hello, world".upper())
print("HELLO, WORLD".lower())
print("hello, world".starts_with("hello"))
print("hello, world".ends_with("world?"))
print("hello, world".contains("o, w"))
print("hello, world".find("world"))
print(x * 14)