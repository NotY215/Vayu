# ---- Lists ----
nums = [1, 2, 3, 4, 5]
print(nums)
print(len(nums))
print(nums[0])
print(nums[4])

nums.append(6)
print(nums)
print(len(nums))

last = nums.pop()
print(last)
print(nums)

nums.insert(0, 0)
print(nums)

nums[0] = 100
print(nums)

# Negative indexing
print(nums[-1])

# Slicing isn't implemented yet -- skip.

# `in`
print(3 in nums)
print(999 in nums)
print(nums.contains(2))

# List arithmetic
print([1, 2] + [3, 4])
print([0] * 3)

# Empty list
empty = []
print(empty, len(empty))

# Nested list
grid = [[1, 2], [3, 4]]
print(grid[0][1])

# ---- Maps ----
ages = {"alice": 30, "bob": 25}
print(ages)
print(ages["alice"])
print(len(ages))

ages["carol"] = 40
print(ages["carol"])

ages.put("dave", 22)
print(ages["dave"])
print(ages.contains("dave"))
print("alice" in ages)

ages.remove("bob")
print(ages.contains("bob"))

keys = ages.keys()
print(len(keys))

# Empty map
emptyMap = {}
print(emptyMap)

# ---- for loops ----
total = 0
for n in nums:
    total = total + n
print("sum:", total)

for x in [10, 20, 30]:
    print(x)

# range
for i in range(5):
    print(i)

for i in range(2, 8):
    print(i)

for i in range(0, 10, 2):
    print(i)

# for over map keys
for name in ages:
    print(name)

# for over string
for c in "abc":
    print(c)

# ---- for + break / continue ----
for n in [1, 2, 3, 4, 5, 6]:
    if n == 4:
        break
    print(n)

for n in [1, 2, 3, 4, 5]:
    if n % 2 == 0:
        continue
    print(n)

# ---- nested collection ----
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
rowSum = 0
for row in matrix:
    for cell in row:
        rowSum = rowSum + cell
print("matrix sum:", rowSum)

# ---- list in a function ----
def total_of(lst: list<int>) -> int:
    s = 0
    for x in lst:
        s = s + x
    return s

print(total_of([10, 20, 30, 40]))

# ============================================================
# Combined from list_methods.vyu to keep collection coverage in one runnable example.
# ============================================================

# List methods: append, extend, count, first, last, copy, reverse, and sort.

xs = [3, 1, 2]
xs.append(5)
print(xs)
ys = [10, 20]
xs.extend(ys)
print(xs)
print(xs.count(5))
print(xs.count(99))
print(xs.first())
print(xs.last())
zs = xs.copy()
zs.reverse()
print(zs)
print(xs)
nums = [3, 1, 4, 1, 5, 9, 2, 6]
nums.sort()
print(nums)
words = ["banana", "apple", "cherry"]
words.sort()
print(words)

# ============================================================
# Combined from map_methods.vyu to keep collection coverage in one runnable example.
# ============================================================

# Map methods: set, get_or, has_key, pop, pop_or, update, copy, and items.

m = {"a": 1, "b": 2}
m.set("c", 3)

print(len(m))
print(m.get_or("a", -1))
print(m.get_or("zzz", -1))
print(m.has_key("b"))
print(m.has_key("zzz"))

print(m.pop("a"))
print(m.has_key("a"))
print(m.pop_or("zzz", 99))
print(len(m))

n = {"x": 10, "y": 20}
m.update(n)
print(m.get("b"))
print(m.get("c"))
print(m.get("x"))
print(m.get("y"))

snapshot = m.copy()
snapshot.set("fresh", 100)
print(m.get_or("fresh", -1))
print(snapshot.get_or("fresh", -1))
print(len(m))
print(len(snapshot))

items = m.items()
print(len(items))

# ============================================================
# Combined from string_methods.vyu to keep collection coverage in one runnable example.
# ============================================================

# String methods: casing, padding, counting, searching, partitioning, and character checks.

method_text = "hello world"
print(method_text.capitalize())
print(method_text.title())
print("Hello World".swapcase())
print("[" + method_text.center(20) + "]")
print("[" + method_text.center(20, "*") + "]")
print("[" + method_text.ljust(15, ".") + "]")
print("[" + method_text.rjust(15, ".") + "]")
print("42".zfill(5))
print("-42".zfill(6))
print("banana".count("an"))
print("banana".count("a"))
print("banana".rfind("a"))
print("a-b-c".partition("-"))
print("a-b-c".rpartition("-"))
print("nosep".partition("-"))
print("nosep".rpartition("-"))
print("a\nb\r\nc".splitlines())
print("a,b,c,d".rsplit(",", 2))
print("HELLO".is_lower())
print("hello".is_lower())
print("hello".is_upper())
print("HELLO".is_upper())
print("abc123".is_alnum())
print("abc 123".is_alnum())
print("hello".is_ascii())

# ============================================================
# Combined from sets.vyu to keep collection coverage in one runnable example.
# ============================================================

set_values = {1, 2, 3}
print(len(set_values))
print(1 in set_values)
print(99 in set_values)
set_values.add(4)
print(len(set_values))
set_values.add(1)
print(len(set_values))
print(set_values.contains(3))
print(set_values.contains(99))
set_values.remove(2)
print(len(set_values))
print(set_values.contains(2))
set_values.discard(99)
print(len(set_values))
a = {1, 2, 3}
b = {3, 4, 5}
u = a.union(b)
i = a.intersection(b)
d = a.difference(b)
print(len(u))
print(len(i))
print(len(d))
print(1 in u)
print(3 in i)
print(4 in i)
print(1 in d)
print(3 in d)
c = a.copy()
c.add(99)
print(len(a))
print(len(c))
for x in a:
    print(x)
empty_set = set([])
print(len(empty_set))
print(empty_set)

# ============================================================
# Combined from tuples.vyu to keep collection coverage in one runnable example.
# ============================================================

tuple_values = (1, 2, 3)
print(tuple_values)
print(tuple_values[0])
print(tuple_values[1])
print(tuple_values[2])
print(len(tuple_values))
u = (42,)
print(u)
print(u[0])
print(len(u))
empty_tuple = ()
print(empty_tuple)
print(len(empty_tuple))
mixed = (1, "two", true)
print(mixed)
print(tuple_values == (1, 2, 3))
print(tuple_values == (1, 2, 4))
print(tuple_values.count(2))
print(tuple_values.count(99))
print(tuple_values.index(3))
for x in tuple_values:
    print(x)
print(tuple([10, 20, 30]))
print(tuple("abc"))

# ============================================================
# Combined from slice_concat.vyu to keep collection coverage in one runnable example.
# ============================================================

xs = [10, 20, 30, 40, 50]
print(xs[1:3])
print(xs[:3])
print(xs[2:])
print(xs[:])
print(xs[0:0])
print(xs[3:1])

slice_text = "hello world"
print(slice_text[0:5])
print(slice_text[6:])
print(slice_text[:5])
print(slice_text[:])
print(slice_text[-5:])

slice_tuple = (1, 2, 3, 4)
print(slice_tuple[1:3])
print(slice_tuple[:2])
print(slice_tuple[2:])
print(slice_tuple[:])

slice_a = (1, 2)
slice_b = (3, 4)
slice_c = slice_a + slice_b
print(slice_c)
print(len(slice_c))

slice_empty = ()
print(slice_empty + slice_empty)

# ============================================================
# Combined from zip_enum.vyu to keep collection coverage in one runnable example.
# ============================================================

print("--- enumerate ---")
for (i, x) in enumerate([10, 20, 30]):
    print(i)
    print(x)

print("--- zip ---")
zip_left = [1, 2, 3]
zip_right = ["x", "y", "z"]
for (k, v) in zip(zip_left, zip_right):
    print(k)
    print(v)

print("--- zip direct index ---")
pairs = zip([1, 2], ["a", "b"])
print(pairs[0][0])
print(pairs[0][1])
print(pairs[1][0])
print(pairs[1][1])

print("--- len of zip result ---")
print(len(zip([1, 2, 3], [4, 5, 6])))

print("--- enumerate indexable ---")
e = enumerate(["foo", "bar"])
print(e[0][0])
print(e[0][1])
print(e[1][0])
print(e[1][1])

# ============================================================
# Tuple unpacking and destructuring, combined from unpack.vyu.
# ============================================================

unpack_tuple = (1, 2, 3)
unpack_a, unpack_b, unpack_c = unpack_tuple
print(unpack_a)
print(unpack_b)
print(unpack_c)
print(unpack_a + unpack_b + unpack_c)

unpack_pair = ("hello", "world")
unpack_x, unpack_y = unpack_pair
print(unpack_x)
print(unpack_y)
print(unpack_x + " " + unpack_y)

unpack_one = (42,)
unpack_z = unpack_one[0]
print(unpack_z)

unpack_pairs = [(1, 2), (3, 4), (5, 6)]
unpack_total = 0
for (unpack_k, unpack_v) in unpack_pairs:
    print(unpack_k)
    print(unpack_v)
    unpack_total = unpack_total + unpack_k + unpack_v
print(unpack_total)

for unpack_item in [10, 20, 30]:
    print(unpack_item)
