# examples/gui_transform.vyu -- Phase 20.3 demo.
# Affine transforms, clipping, fill modes.

import gui

const EV_PAINT: int = 1
const EV_CLOSE: int = 7
const EV_TIMER: int = 8

const W: int = 720
const H: int = 520

font_sm: int = 0

def draw_sq_rot(c: int, x: int, y: int, size: int, deg: int) -> None:
    gui.push_transform(c)
    if deg != 0:
        gui.rotate_at(c, deg, x + size // 2, y + size // 2)
    gui.canvas_fill_rect(c, x, y, size, size, 0xFF3366CC)
    gui.canvas_outline_rect(c, x, y, size, size, 0xFFFFFFFF, 2)
    gui.pop_transform(c)

def draw_sq_scaled(c: int, x: int, y: int, size: int, pct: int) -> None:
    gui.push_transform(c)
    cx: int = x + size // 2
    cy: int = y + size // 2
    gui.translate(c, cx, cy)
    gui.scale(c, pct, pct)
    gui.translate(c, -cx, -cy)
    gui.canvas_fill_rect(c, x, y, size, size, 0xFF4CAF50)
    gui.canvas_outline_rect(c, x, y, size, size, 0xFFFFFFFF, 2)
    gui.pop_transform(c)

def draw_star(c: int, cx: int, cy: int, r: int, argb: int) -> None:
    # 5-point pentagram, integer coordinates. Self-intersecting by design.
    pts: list<int> = [
        cx,                 cy - r,
        cx + (r * 59) // 100,  cy + (r * 81) // 100,
        cx - (r * 95) // 100,  cy - (r * 31) // 100,
        cx + (r * 95) // 100,  cy - (r * 31) // 100,
        cx - (r * 59) // 100,  cy + (r * 81) // 100
    ]
    gui.polygon(c, pts, argb)
    gui.line_width(c, 2)
    gui.polygon_outline(c, pts, 0xFFFFFFFF)

def on_event(ev: int) -> None:
    if ev == EV_CLOSE:
        gui.quit()
        return
    if ev == EV_TIMER:
        gui.quit()
        return
    if ev != EV_PAINT:
        return
    c: int = gui.canvas_from_window()
    gui.canvas_clear(c, 0xFF1A1A2E)

    # Row 1: rotation 0, 15, 30, 45 deg.
    draw_sq_rot(c,  30,  30, 80, 0)
    draw_sq_rot(c, 150,  30, 80, 15)
    draw_sq_rot(c, 270,  30, 80, 30)
    draw_sq_rot(c, 390,  30, 80, 45)

    # Row 2: scale 50%, 100%, 150%.
    draw_sq_scaled(c,  30, 160, 80, 50)
    draw_sq_scaled(c, 150, 160, 80, 100)
    draw_sq_scaled(c, 270, 160, 80, 150)

    # Clip demo: three overlapping rects, only the top-left 200x200 corner
    # is visible.
    gui.push_transform(c)
    gui.clip_rect(c, 420, 30, 200, 200)
    gui.canvas_fill_rect(c, 420,  30, 400, 400, 0xFFFF6B6B)
    gui.canvas_fill_rect(c, 470,  80, 400, 400, 0xFF4CAF50)
    gui.canvas_fill_rect(c, 520, 130, 400, 400, 0xFF2196F3)
    gui.pop_transform(c)
    gui.line_width(c, 2)
    gui.canvas_outline_rect(c, 420, 30, 200, 200, 0xFFFFC107, 2)

    # Fill mode: same self-intersecting star, alternate vs winding.
    gui.fill_mode(c, 0)
    draw_star(c, 500, 380, 80, 0xFFFFC107)
    gui.fill_mode(c, 1)
    draw_star(c, 640, 380, 80, 0xFF7E57C2)
    gui.fill_mode(c, 1)

    gui.text_ex(c, font_sm, "rotate 0 / 15 / 30 / 45",
                30, 265, 0xFFB0BEC5)
    gui.text_ex(c, font_sm, "scale 50% / 100% / 150%",
                30, 285, 0xFFB0BEC5)
    gui.text_ex(c, font_sm, "clip 200x200",
                420, 245, 0xFFB0BEC5)
    gui.text_ex(c, font_sm, "fill: alternate",
                440, 485, 0xFFFFC107)
    gui.text_ex(c, font_sm, "fill: winding",
                600, 485, 0xFF7E57C2)

    gui.canvas_free(c)

def main() -> None:
    gui.init()
    win: int = gui.create_window("Vayu transforms", W, H)
    font_sm = gui.font_new("Consolas", 14, 400, 0)
    gui.set_callback(&on_event)
    gui.show_window(win)
    gui.set_timer(1500)
    gui.run(win)
    gui.font_free(font_sm)
    print("transform demo done")

main()