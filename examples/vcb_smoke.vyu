# vcb_smoke.vyu -- exercises the VCB backend.
# Expected stdout:
#   7
#   -1
# Expected exit code: 42 (via exit(add(40, 2)))

def add(a: int, b: int) -> int:
    return a + b

def sub(a: int, b: int) -> int:
    return a - b

x: int = 3
y: int = 4
print(add(x, y))
print(sub(x, y))

n: int = 40
m: int = 2
exit(add(n, m))