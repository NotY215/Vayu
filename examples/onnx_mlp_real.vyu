# examples/onnx_mlp_real.vyu -- Phase 22.3b demo.
# Loads a real .onnx file from disk and runs it.
# Requires examples/assets/tiny_mlp.onnx to exist (generated by tools).

import tensor
import onnx
import fs

const Q: int = 65536

def main() -> None:
    path: str = "examples/assets/tiny_mlp.onnx"
    if not fs.exists(path):
        print("missing " + path)
        print("generate with: python tools/make_tiny_onnx.py")
        exit(1)

    m: int = onnx.load(path)
    if m == 0:
        print("onnx.load failed")
        exit(1)

    iname: str = onnx.input_name(m)
    oname: str = onnx.output_name(m)
    print("input  = " + iname)
    print("output = " + oname)

    # Input matches the model's first input; shape depends on the file.
    x: int = tensor.from_int_list([1, 4], [1*Q, 0, 0, 0])
    y: int = onnx.run(m, x)
    if y == 0:
        print("onnx.run failed")
        exit(1)
    tensor.print(y, "y")

    tensor.free(x)
    tensor.free(y)
    onnx.free(m)

main()