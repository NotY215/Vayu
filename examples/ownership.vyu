class Resource:
    name: str
    def __init__(self, n: str) -> None:
        self.name = n

def consume<T>(u: unique<T>) -> T:
    return u

def main() -> None:
    a: unique<Resource> = Resource("first")
    print(a.name)

    # Move a into b — a is now unusable.
    b: unique<Resource> = a
    print(b.name)

    # Rebind a (a is a fresh binding now).
    a = Resource("second")
    print(a.name)

    # unique<int> works too.
    n: unique<int> = 99
    print(n)

main()