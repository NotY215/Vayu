s = {1, 2, 3}
print(len(s))
print(1 in s)
print(99 in s)
s.add(4)
print(len(s))
s.add(1)
print(len(s))
print(s.contains(3))
print(s.contains(99))
s.remove(2)
print(len(s))
print(s.contains(2))
s.discard(99)
print(len(s))
a = {1, 2, 3}
b = {3, 4, 5}
u = a.union(b)
i = a.intersection(b)
d = a.difference(b)
print(len(u))
print(len(i))
print(len(d))
print(1 in u)
print(3 in i)
print(4 in i)
print(1 in d)
print(3 in d)
c = a.copy()
c.add(99)
print(len(a))
print(len(c))
for x in a:
    print(x)
empty = set([])
print(len(empty))
print(empty)