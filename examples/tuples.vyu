print(t)
print(t[0])
print(t[1])
print(t[2])
print(len(t))
u = (42,)
print(u)
print(u[0])
print(len(u))
empty = ()
print(empty)
print(len(empty))
mixed = (1, "two", true)
print(mixed)
print(t == (1, 2, 3))
print(t == (1, 2, 4))
print(t.count(2))
print(t.count(99))
print(t.index(3))
for x in t:
    print(x)
print(tuple([10, 20, 30]))
print(tuple("abc"))