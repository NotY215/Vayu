# examples/onnx_mlp.vyu -- Phase 22.3 demo.
# Builds a 2-layer MLP as a .vnn text model in memory, loads, runs.

import tensor
import onnx

const Q: int = 65536

def main() -> None:
    # Model: y = ReLU(x @ W1 + b1) @ W2
    # x shape [1, 4], W1 shape [4, 3], b1 shape [1, 3],
    # W2 shape [3, 1].
    # Weights chosen so that for x = [1,0,0,0], the answer is 4.0.
    #
    # W1 row 0 = [1, 1, 1]
    # W2 col 0 = [1, 1, 2]
    # b1 = [0, 0, 0]
    # x @ W1 = [1, 1, 1]
    # relu = [1, 1, 1]
    # h @ W2 = 1*1 + 1*1 + 1*2 = 4.0
    model: str = ""
    model = model + "input x\n"
    model = model + "tensor W1 4 3 " + str(1*Q) + " " + str(1*Q) + " " + str(1*Q) + " 0 0 0 0 0 0 0 0 0\n"
    model = model + "tensor b1 1 3 0 0 0\n"
    model = model + "op gemm x W1 h1\n"
    model = model + "op add h1 b1 h1b\n"
    model = model + "op relu h1b h2\n"
    model = model + "tensor W2 3 1 " + str(1*Q) + " " + str(1*Q) + " " + str(2*Q) + "\n"
    model = model + "op gemm h2 W2 out\n"

    x: int = tensor.from_int_list([1, 4], [1*Q, 0, 0, 0])

    print("building model...")
    y: int = onnx.run_str(model, x)
    if y == 0:
        print("model returned null")
        exit(1)

    tensor.print(y, "y")
    print("expected: y shape=[1,1] data=[4.0000]")

    tensor.free(x)
    tensor.free(y)

main()