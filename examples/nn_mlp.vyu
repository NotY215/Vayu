# examples/nn_mlp.vyu -- Phase 22.2 demo.
# Two-layer MLP fits y = 2x + 1.  Native only.

import tensor
import nn

const Q: int = 65536

def main() -> None:
    # Data
    x: int = tensor.from_int_list([8, 1],
        [1*Q, 2*Q, 3*Q, 4*Q, 5*Q, 6*Q, 7*Q, 8*Q])
    y: int = tensor.from_int_list([8, 1],
        [3*Q, 5*Q, 7*Q, 9*Q, 11*Q, 13*Q, 15*Q, 17*Q])

    # Linear(1 -> 8), Linear(8 -> 1).  W1, b1, W2, b2.
    p1: list<int> = nn.linear_init(1, 8, 1)
    p2: list<int> = nn.linear_init(8, 1, 2)
    W1: int = p1[0]
    b1: int = p1[1]
    W2: int = p2[0]
    b2: int = p2[1]

    tensor.requires_grad(W1, 1)
    tensor.requires_grad(b1, 1)
    tensor.requires_grad(W2, 1)
    tensor.requires_grad(b2, 1)

    lr: int = Q // 50   # 0.02
    epoch: int = 0
    max_epochs: int = 400
    while epoch < max_epochs:
        tensor.tape_clear()

        h_pre: int = nn.linear_forward(x, W1, b1)
        # tanh has non-zero gradient everywhere; ReLU with this shallow a
        # net and Q16.16 fixed-point dies.  22.x will add BatchNorm-style
        # stabilisation for ReLU.
        h: int = nn.tanh(h_pre)
        out: int = nn.linear_forward(h, W2, b2)

        loss: int = nn.mse_loss(out, y)

        tensor.backward(loss)

        nn.sgd_step(W1, lr)
        nn.sgd_step(b1, lr)
        nn.sgd_step(W2, lr)
        nn.sgd_step(b2, lr)

        tensor.zero_grad(W1)
        tensor.zero_grad(b1)
        tensor.zero_grad(W2)
        tensor.zero_grad(b2)

        if epoch % 100 == 0:
            tensor.print(loss, "loss")
        epoch = epoch + 1

    print("")
    print("final predictions vs truth:")
    h_pre: int = nn.linear_forward(x, W1, b1)
    h: int = nn.tanh(h_pre)
    out: int = nn.linear_forward(h, W2, b2)
    tensor.print(out, "pred")
    tensor.print(y, "true")

main()