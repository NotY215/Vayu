class Player:
    name: str
    health: int

    def __init__(self, name: str) -> None:
        self.name = name
        self.health = 100

    def damage(self, amount: int) -> None:
        self.health = self.health - amount

    def describe(self) -> str:
        return self.name + " has " + str(self.health) + " hp"

class Warrior(Player):
    rage: int

    def __init__(self, name: str) -> None:
        super().__init__(name)
        self.rage = 0

    def damage(self, amount: int) -> None:
        super().damage(amount)
        self.rage = self.rage + amount

    def describe(self) -> str:
        return super().describe() + " [rage " + str(self.rage) + "]"

p = Player("NotY")
p.damage(20)
print(p.describe())

w = Warrior("Brutus")
w.damage(30)
w.damage(15)
print(w.describe())

# inherit without override
class Mage(Player):
    mana: int
    def __init__(self, name: str) -> None:
        super().__init__(name)
        self.mana = 50

m = Mage("Zara")
m.damage(10)
print(m.describe())
print(m.mana)

# subclass of subclass
class Archmage(Mage):
    def cast(self) -> str:
        return self.name + " casts a spell"

a = Archmage("Merlin")
a.damage(5)
print(a.describe())
print(a.cast())

# instance methods can call each other
class Counter:
    value: int
    def __init__(self) -> None:
        self.value = 0
    def inc(self) -> None:
        self.value = self.value + 1
    def inc_n(self, n: int) -> None:
        i = 0
        while i < n:
            self.inc()
            i = i + 1

c = Counter()
c.inc_n(5)
print(c.value)

# ============================================================
# Combined from delattr.vyu to cover related class/runtime features.
# ============================================================

class Bag:
    a: int
    b: int
    def __init__(self) -> None:
        self.a = 1
        self.b = 2

def main() -> None:
    bag = Bag()
    print(bag.a)
    print(bag.b)

    delattr(bag, "b")
    print(hasattr(bag, "b"))
    print(hasattr(bag, "a"))

    # re-add via setattr
    setattr(bag, "b", 99)
    print(bag.b)

main()

# ============================================================
# Combined from static_test.vyu to cover related class/runtime features.
# ============================================================

class Counter:
    value: int
    total: int
    static count: int = 0
    static capacity: int = 100

    def __init__(self, value: int) -> None:
        self.value = value
        self.total = value * 2
        Counter.count = Counter.count + 1

    def report(self) -> int:
        return self.value + Counter.count

def main() -> None:
    print(Counter.count)
    print(Counter.capacity)
    a = Counter(10)
    b = Counter(20)
    c = Counter(30)
    print(Counter.count)
    print(a.report())
    print(b.report())
    print(c.report())
    Counter.capacity = 200
    print(Counter.capacity)

main()

# ============================================================
# Combined from inspect.vyu to cover related class/runtime features.
# ============================================================

class Point:
    x: int
    y: int
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y
    def dist2(self) -> int:
        return self.x * self.x + self.y * self.y

class Animal:
    name: str
    def __init__(self, n: str) -> None:
        self.name = n

class Dog(Animal):
    def __init__(self) -> None:
        self.name = "rex"

def main() -> None:
    print(callable(print))
    print(callable(3))

    p = Point(3, 4)
    print(isinstance(p, Point))
    print(isinstance(p, Animal))

    d = Dog()
    print(isinstance(d, Animal))
    print(isinstance(d, Dog))

    print(issubclass(Dog, Animal))
    print(issubclass(Animal, Dog))
    print(issubclass(Point, Exception))

    print(hasattr(p, "x"))
    print(hasattr(p, "dist2"))
    print(hasattr(p, "zzz"))

    print(getattr(p, "x"))
    print(getattr(p, "y"))

    h1 = hash("hello")
    h2 = hash("hello")
    print(h1 == h2)
    print(hash(42) == hash(42))

    print(repr("abc"))
    print(repr(42))

    print(enumerate(["a", "b", "c"]))
    print(zip([1, 2, 3], ["x", "y", "z"]))
    print(reversed([1, 2, 3, 4]))

    print(round(3.14159))
    print(round(3.14159, 2))
    print(pow(2, 10))
    print(pow(2, 10, 1000))
    print(divmod(17, 5))
    print(sign(-7))
    print(sign(0))
    print(sign(42))
    print(gcd(12, 18))
    print(lcm(4, 6))
    print(clamp(15, 0, 10))
    print(clamp(-3, 0, 10))
    print(clamp(5, 0, 10))

    names = dir(p)
    print(len(names) > 0)

main()
