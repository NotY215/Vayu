{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vayu",
  "scopeName": "source.vayu",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#classes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.vayu",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vayu",
          "match": "\\b(if|elif|else|while|for|break|continue|pass|return|match|case|with|as|try|except|finally|raise|yield|defer|import|from|in|is|and|or|not)\\b"
        },
        {
          "name": "keyword.declaration.vayu",
          "match": "\\b(def|class|struct|enum|interface|const|extern|unsafe|namespace|lambda|static|public|private|protected)\\b"
        },
        {
          "name": "constant.language.vayu",
          "match": "\\b(true|false|none|True|False|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.vayu",
          "match": "\\b(int|float|bool|str|char|bytes|list|map|ptr|ref|unique|shared|weak|tuple|set)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.vayu",
          "match": "\\b(print|str|bool|int|float|len|abs|type|min|max|input|range|ord|chr|list|map|filter|sorted|reduce|any|all|sum|hash|id|callable|isinstance|issubclass|getattr|hasattr|dir|repr|enumerate|zip|reversed|round|pow|divmod|sign|gcd|lcm|clamp|comb|perm|isqrt|factorial|tuple|set|setattr|delattr|next|malloc|free|read_file|write_file|file_exists|args|run_command|exit|print_raw|join)\\b"
        },
        {
          "name": "support.constant.vayu",
          "match": "\\b(math|fs|time|json|regex|thread|net|crypto|random|os|py)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vayu",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.oct.vayu",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.bin.vayu",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.vayu",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.int.vayu",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vayu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vayu",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.vayu",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vayu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vayu",
          "match": "==|!=|<=|>=|<<|>>|\\*\\*|//|[-+*/%&|^~<>=!]=?"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vayu",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.vayu",
          "match": "\\b(?:class|struct|enum|interface)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": { "1": { "name": "entity.name.type.vayu" } }
        }
      ]
    }
  }
}