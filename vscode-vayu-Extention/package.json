{
  "name": "vayu",
  "displayName": "Vayu",
  "description": "Language support for Vayu: syntax highlighting, language server, formatter, linter.",
  "version": "1.0.0",
  "publisher": "Fliczo",
  "engines": { "vscode": "^1.75.0" },
  "categories": [ "Programming Languages" ],
  "icon": "Vayu_logo.png",
  "activationEvents": [
    "onLanguage:vayu"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotY215/Vayu.git"
  },
  "license": "Apache-2.0",
  "keywords": [ "vayu", "vyu", "language", "lsp" ],
  "contributes": {
    "languages": [
      {
        "id": "vayu",
        "aliases": [ "Vayu", "vayu" ],
        "extensions": [ ".vyu" ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/Vyu_Icon.ico",
          "dark": "./assets/Vyu_Icon_Dark.ico"
        }
      }
    ],
    "grammars": [
      {
        "language": "vayu",
        "scopeName": "source.vayu",
        "path": "./vayu.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "vayu.formatFile",
        "title": "Vayu: Format File"
      },
      {
        "command": "vayu.lintFile",
        "title": "Vayu: Lint File"
      },
      {
        "command": "vayu.restartServer",
        "title": "Vayu: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Vayu",
      "properties": {
        "vayu.vlsPath": {
          "type": "string",
          "default": "",
          "description": "Path to vls (vls.exe on Windows).  Leave empty to auto-detect: <workspace>/build/x64-debug/bin/vls[.exe]."
        },
        "vayu.vfmtPath": {
          "type": "string",
          "default": "",
          "description": "Path to vfmt (vfmt.exe on Windows).  Leave empty to auto-detect."
        },
        "vayu.vlintPath": {
          "type": "string",
          "default": "",
          "description": "Path to vlint (vlint.exe on Windows).  Leave empty to auto-detect."
        }
      }
    }
  }
}